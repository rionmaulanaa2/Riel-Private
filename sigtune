local forceLeft = {}, lastPlayersRef = {}, livePlayers = {}, playerJoinTime = {}

local function StripColors(s) if not s then return "" end; return tostring(s):gsub("`[0-9a-zA-Z]", "") end

-- Reset tracking on world change
