-- Returns true if a userid is in the whitelist
local function IsWhitelisted(userid)
    for _, uid in ipairs(Config.Whitelist) do
        if uid == userid then return true end
    end
    return false
end

-- ============================================================
-- MOD / DEVELOPER DETECTION (invisible entry)
-- ============================================================
-- Developers and Moderators can enter invisible (not in GetPlayerList).
-- They trigger an OnSpawn variant where their properties are sent.

AddHook("onvariant", "ModDevDetector", function(var)
    if var[0] == "OnSpawn" then
        local spawnData = tostring(var[1] or "")
        -- Check for Developer/Moderator type flags or invisible states
        local typeVal = tonumber(spawnData:match("type|(%d+)"))
        local isMod = typeVal and ((typeVal & 4) ~= 0)
        local isDev = typeVal and ((typeVal & 8) ~= 0)
        
        -- Also check for invis/mstate flags that might indicate staff
        local isInvis = spawnData:find("invis|1") or spawnData:find("mstate|1")
        
        local name = spawnData:match("name|([^\n]+)") or "Unknown"
        local userid = tonumber(spawnData:match("userID|(%d+)"))
        
        -- We ignore our own spawn packet (Growtopia sends local|1 for the local player)
        if spawnData:find("\nlocal|1\n") or spawnData:find("local|1") then
            return false
        end
        
        -- Fallback local player check using userid
        local local_ = GetLocal()
        if local_ and local_.userid and userid == local_.userid then
            return false
        end
        
        -- Also ignore if they are in our whitelist (so you can whitelist your mod friends)
        if userid and IsWhitelisted(userid) then
            return false
        end

        if isMod or isDev or isInvis then
            local role = isDev and "`4[DEVELOPER]" or (isMod and "`6[MODERATOR]" or "`b[INVISIBLE STAFF]")
            Log("`4ALL FEATURES PAUSED! " .. role .. "`0 detected entering world: `e" .. name)
            modDetected = true
            Paused = true
            Run = false
        end
    end
    
    -- Handle Backpack Resupply UI parsing
    if var[0] == "OnDialogRequest" and waitingForBackpackItem and type(var[1]) == "string" and var[1]:find("backpack_menu") then
        local dialog = var[1]
        local itemIDStr = tostring(waitingForBackpackItem)
        -- Match: add_button_with_icon|<SLOT>|<Name>|frame|<ITEM_ID>|<AMOUNT>|
        local pattern = "add_button_with_icon|(%d+)|[^|]*|frame|" .. itemIDStr .. "|"
        local slot = dialog:match(pattern)
        
        if slot then
            SendPacket(2, "action|dialog_return\ndialog_name|backpack_menu\nbuttonClicked|" .. slot)
            Log("`2Resupplied item `b" .. itemIDStr .. "`2 from backpack slot `b" .. slot .. "`0")
        else
            Log("`4Item `b" .. itemIDStr .. "`4 not found in backpack! Pausing AutoPlace.`0")
            Config.AutoPlace = false
        end
        
        waitingForBackpackItem = nil
        return true -- Block the dialog from showing on screen
    end
    
    return false
end)

-- Get a table of current players (excluding local player), keyed by netid
local function GetOtherPlayers()
    local players = {}
    local local_ = GetLocal()
    if not local_ then return players end

    local list = GetPlayerList()
    if not list then return players end

    for _, p in pairs(list) do
        if p and p.netid ~= local_.netid then
            players[p.netid] = { name = p.name, userid = p.userid }
        end
    end
    return players
end

-- Punch the target tile once
local function PunchTile()
    SendPacketRaw(false, {
        type  = 3,
        value = Config.ItemID,
        px    = Config.TileX,
        py    = Config.TileY,
        x     = Config.TileX * 32,
