                        PreviousConfig.AutoJoinRunning = Config.AutoJoinRunning
                        PreviousConfig.AutoJoin = Config.AutoJoin

                        Config.AutoPunch = false
                        Config.AutoPlace = false
                        Config.AutoPunchWorld = false
                        Config.AutoClearWorld = false
                        Config.AutoClearWater = false
                        Config.AutoTake = false
                        Config.AutoBackpack = false
                        Config.AutoJoinRunning = false
                        Config.AutoJoin = false
                    end
                else
                    if Paused then
                        Paused = false
                        Log("`2No strangers! Resuming previously active features.")
                        
                        Config.AutoPunch = PreviousConfig.AutoPunch or false
                        Config.AutoPlace = PreviousConfig.AutoPlace or false
                        Config.AutoPunchWorld = PreviousConfig.AutoPunchWorld or false
                        Config.AutoClearWorld = PreviousConfig.AutoClearWorld or false
