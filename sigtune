    [4310] = "Transfusion",
    [4312] = "Defibrillator",
    [4314] = "Clamp",
    [4316] = "Ultrasound",
    [4318] = "Lab Kit",
}

-- Send surgery action using the real button ID from the dialog
-- Wraps in RunThread+Sleep so the server is not flooded
local function SendSurg(toolID, toolName)
    if not Config.AutoSurgery or Paused or not Run then return end
    local delay = math.max(100, Config.SurgeryDelay or 700)
    RunThread(function()
        Sleep(delay)
