local function ClearWorldStep()
    local world = GetWorld()
    if not world then Sleep(200); return end
    if clearWX == nil then InitializeClear() end
    if (Config.ClearDirection == "top" and clearWY >= world.height) or (Config.ClearDirection == "bottom" and clearWY < 0) then
        Log("`2[Clear World] `0Finished! Transitioning to water clear...")
        Config.AutoClearWorld = false; clearWX, clearWY = nil, nil
        Config.AutoClearWater = true; return
    end
    local targetX, targetY = nil, nil
    local passes, maxPasses = 0, 400
    while passes < maxPasses do
        if Config.ClearDirection == "top" and clearWY >= world.height then break end
        if Config.ClearDirection == "bottom" and clearWY < 0 then break end
        local key = clearWX * 10000 + clearWY
        local cell = SafeGetTile(clearWX, clearWY)
        if not clearWVisited[key] then
            local skipFg = IsIgnoredClearBlock(cell.fg)
            local skipBg = IsIgnoredClearBlock(cell.bg)
            if (cell.fg ~= 0 or cell.bg ~= 0) and not skipFg and not skipBg then
                targetX = clearWX; targetY = clearWY; break
            else clearWVisited[key] = true end
        end
        clearWX = clearWX + 1
        if clearWX >= world.width then clearWX = 0; clearWY = Config.ClearDirection == "top" and (clearWY + 1) or (clearWY - 1) end
        passes = passes + 1
    end
    if not targetX or not targetY then return end
    if lastClearRowY ~= targetY then lastClearRowY = targetY; local pct = math.floor((targetY / math.max(1, world.height - 1)) * 100); Log("`2[Clear World] `0Clearing Y: `b" .. targetY .. "`0/" .. (world.height - 1) .. " (" .. pct .. "%)") end
    if Config.ClearWorldTeleportRow then SendPacketRaw(false, {type = 0, x = 0, y = targetY * 32, px = 0, py = targetY}) end
    local multiTargetList = {}
    for dx = 0, 4 do
        local tx = targetX + dx
        if tx < world.width then
            local key = tx * 10000 + targetY
            if not clearWVisited[key] then
                local cell = SafeGetTile(tx, targetY)
                if not IsIgnoredClearBlock(cell.fg) and not IsIgnoredClearBlock(cell.bg) and (cell.fg ~= 0 or cell.bg ~= 0) then
                    table.insert(multiTargetList, tx)
                else clearWVisited[key] = true end
            end
        end
    end
    if #multiTargetList > 0 then
        for _, tx in ipairs(multiTargetList) do
            if not Run or Paused or not Config.AutoClearWorld then return end
            SendPacketRaw(false, {type = 3, value = 18, px = tx, py = targetY, x = tx * 32, y = targetY * 32})
        end
        Sleep(Config.ClearDelay)
        for _, tx in ipairs(multiTargetList) do
            local cell = SafeGetTile(tx, targetY)
            if (cell.fg == 0 and cell.bg == 0) or IsIgnoredClearBlock(cell.fg) or IsIgnoredClearBlock(cell.bg) then clearWVisited[tx * 10000 + targetY] = true end
        end
    else
        clearWVisited[targetX * 10000 + targetY] = true
        clearWX = targetX + 1
        if clearWX >= world.width then clearWX = 0; clearWY = Config.ClearDirection == "top" and (targetY + 1) or (targetY - 1) end
    end
end

-- Clear Water
local waterCX, waterCY = nil, nil
local function IsWaterTile(cell)
    if not cell then return false end
    if cell.fg == 8 or IsIgnoredClearBlock(cell.fg) or IsIgnoredClearBlock(cell.bg) then return false end
    if cell.water == true or cell.water == 1 then return true end
    if type(cell.flags) == "table" then if cell.flags.water == true or cell.flags.water == 1 then return true end end
    if type(cell.flags) == "number" then if (cell.flags & 0x0040) ~= 0 or (cell.flags & 0x0080) ~= 0 or (cell.flags & 0x0200) ~= 0 then return true end end
    return false
end

local function InitializeClearWater()
    local world = GetWorld()
    if not world then return end
