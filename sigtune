local function GoToMagplant(mx, my)
    local world = GetWorld()
    if not world then return end

    local function isWalkable(x, y)
        if x < 0 or x >= world.width or y < 0 or y >= world.height then return false end
        local t = GetTile(x, y)
        if not t then return true end
        if t.fg == 0 then return true end
        return false
    end

    local candidates = {
        { x = mx,     y = my - 1 }, -- Top
        { x = mx - 1, y = my },     -- Left
        { x = mx + 1, y = my },     -- Right
        { x = mx,     y = my + 1 }, -- Bottom
    }

    local targetX, targetY = nil, nil
    for _, c in ipairs(candidates) do
        if isWalkable(c.x, c.y) then
            targetX = c.x
            targetY = c.y
            break
        end
    end

    if not targetX or not targetY then
        targetX = mx
        targetY = my - 1
    end

    Log("`9[Magplant] Pathfinding to (" .. targetX .. ", " .. targetY .. ") beside Magplant (" .. mx .. ", " .. my .. ")`0")
    if FindPath then
        FindPath(targetX, targetY, 50)
    end
end

local function GetMagplantRemote(mx, my)
