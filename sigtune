local PreviousConfig = {}

RunThread(function()
    Log("Player watch thread started.")

    while true do
        if Run then
            local world = GetWorld()
            local local_ = GetLocal()

            if world and local_ then
                local current = GetOtherPlayers()

                -- Detect NEW players that joined
                for netid, info in pairs(current) do
                    if not lastPlayers[netid] then
                        local tag = IsWhitelisted(info.userid) and "`a[WHITELIST]`0 " or "`4[STRANGER]`0 "
                        Log(tag .. "`e" .. tostring(info.name) .. "`0 (UID: `b" .. tostring(info.userid) .. "`0) joined.")
                    end
                end

                -- Detect players that LEFT
                for netid, info in pairs(lastPlayers) do
                    if not current[netid] then
                        local tag = IsWhitelisted(info.userid) and "`a[WHITELIST]`0 " or "`4[STRANGER]`0 "
                        Log(tag .. "`e" .. tostring(info.name) .. "`0 (UID: `b" .. tostring(info.userid) .. "`0) left.")
                    end
                end

                -- Update Paused state: pause only if a non-whitelisted player is present
                local hasStranger = false
                for _, info in pairs(current) do
                    if not IsWhitelisted(info.userid) then
                        hasStranger = true
                        break
                    end
                end

                if hasStranger then
                    if not Paused then
                        Paused = true
                        Log("`4Stranger in world! Turning off all features.")
                        
                        PreviousConfig.AutoPunch = Config.AutoPunch
                        PreviousConfig.AutoPlace = Config.AutoPlace
                        PreviousConfig.AutoPunchWorld = Config.AutoPunchWorld
                        PreviousConfig.AutoClearWorld = Config.AutoClearWorld
                        PreviousConfig.AutoClearWater = Config.AutoClearWater
                        PreviousConfig.AutoTake = Config.AutoTake
