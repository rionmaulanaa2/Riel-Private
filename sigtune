= false,\n    JoinBuyItemWorlds     = false,\n    JoinLiveWOTD          = false,\n    JoinHistoricWOTD      = false,\n    BuyItemStartID        = 0,\n    JoinItemAcronymWorlds = false,\n    JoinPacketDelay       = 1000,\n    JoinTimeoutSeconds    = 10,\n    JoinPlaceItem         = 242,\n    JoinPlaceAndLeave     = true,\n    \n    AutoClearWorld    = false,\n    AutoClearWater    = false,\n    AutoSurgery       = false,\n    AutoSurgeryBuy    = false,\n    SurgeryTotal      = 0,\n    RecordName        = "MyRecord",\n    PlaybackFile      = "MyRecord",\n    ClearDirection    = "top",\n    ClearDelay        = 50,\n    ClearSpongeID     = 822,\n    ClearIgnoreBlocks = {\n        [6] = true,     -- White Door\n        [8] = true,     -- Bedrock\n        [202] = true,\n        [242] = true,   -- Main Door\n        [1796] = true,\n        [4992] = true,\n        [5260] = true,\n        [5638] = true,\n        [6948] = true,\n        [6950] = true,\n        [7188] = true,\n        [10266] = true,\n        [11550] = true\n    },\n}\n\n-- ==========================================================================\n-- WORLD LISTS\n-- ==========================================================================\nlocal historicWOTDWorlds = {\n    "NASA11", "DUNGEONSUCKERS", "ALBUM", "DEVELOPERS", "GROWTOPIAN",\n    "ITEMS", "AIRSHIP", "KITCHEN", "THEVULCANO", "MARIOMUSIC",\n    "HOCKEYRINK", "MUSEUM", "SUMO", "YHLAND", "7DEADLYSINS",\n    "LOVERSLOUNGE", "PYRAMIDRUN", "THEFINALPARKOUR", "GTVILLAGE", "LOCKSTREET",\n    "EPICWORLD", "ARTGALLERY", "CITYOFLIGHT", "MEDIEVALFORT", "SPACESTATION",\n    "UNDERWATERBASE", "MAGICFOREST", "DRAGONLAIR", "JUNGLEPARADISE",\n    "PIXELPALACE", "HAUNTEDCASTLE", "SAKURAGARDEN", "MECHANICA",\n    "ANCIENTRUINS", "LOSTCITY", "NEONSCAPE", "STEAMPUNKLAB",\n    "WINTERWONDER", "SPRINGBLOOM", "SUMMERSOLSTICE", "AUTUMNLEAF",\n    "DESERTMAZE", "UNDERSEA", "CLOUDKINGDOM", "THUNDERSTORM",\n    "VOLCANOPEAK", "GLACIERFALL", "FORESTSPIRIT", "MOONLIGHTCOVE",\n