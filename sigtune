local function dedup(list)
    local seen, result = {}, {}
    for _, v in ipairs(list) do
        local key = v:upper()
        if not seen[key] then
            seen[key] = true
            table.insert(result, key)
        end
    end
    return result
end

local function placeAbovePlayer(id)
    local localAvatar = GetLocal()
    if not localAvatar then return end
    local pkt = {}
    pkt.type  = 3
    pkt.value = id
    pkt.px    = math.floor(localAvatar.pos.x / 32)
    pkt.py    = math.floor(localAvatar.pos.y / 32) - 1
    pkt.x     = localAvatar.pos.x
    pkt.y     = localAvatar.pos.y
    SendPacketRaw(false, pkt)
end

RunThread(function()
    Log("Auto Joiner Thread ready.")
    local prevRunning = false
    
    while true do
        if Config.AutoJoinRunning and not prevRunning then
            prevRunning = true
            
            Log("`2Initializing Auto Joiner... (Quitting to exit & waiting 2s)")
            SendPacket(3, "action|quit_to_exit")
            Sleep(2000)
            
            local worldsToVisit = {}

            if Config.JoinLiveWOTD then
                Log("`2[WOTD] Fetching live WOTD...")
                local res = MakeRequest("https://www.growtopiagame.com/detail", "GET")
                if res and res.content then
                    local match = res.content:match('"full_size"%s*:%s*"worlds[\\/]+([^"]+)%.png"')
                    if match then table.insert(worldsToVisit, match:upper()) end
                end
            end

            if Config.JoinHistoricWOTD then for _, w in ipairs(historicWOTDWorlds) do table.insert(worldsToVisit, w) end end
            if Config.JoinViralWorlds then for _, w in ipairs(viralWorlds) do table.insert(worldsToVisit, w) end end
            if Config.JoinPopularWorlds then for _, w in ipairs(popularWorlds) do table.insert(worldsToVisit, w) end end
            if Config.JoinBuyWorlds then for _, w in ipairs(buyWorlds) do table.insert(worldsToVisit, w) end end

            if Config.JoinBuyItemWorlds then
                Log("`2Generating BUY+<itemname> worlds...")
                local allItems = GetItemInfoList()
                if allItems then
                    local maxID = 0
                    for id, _ in pairs(allItems) do if type(id) == "number" and id > maxID then maxID = id end end
                    for id = Config.BuyItemStartID, maxID do
                        local item = allItems[id]
                        if item and item.name and item.name ~= "" and not item.name:match("^%d+$") then
                            local cleanName = item.name:upper():gsub("%s+", ""):gsub("[^%a%d]", "")
                            if #cleanName > 0 and #("BUY" .. cleanName) <= 24 then
                                table.insert(worldsToVisit, "BUY" .. cleanName)
                                if Config.JoinItemAcronymWorlds then
                                    for itemKey, acronyms in pairs(itemAcronyms) do
                                        if item.name:lower() == itemKey:lower() then
                                            for _, acronym in ipairs(acronyms) do table.insert(worldsToVisit, "BUY" .. acronym:upper()) end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end

            if Config.Join2LetterWorlds then
                local start1 = string.byte(Config.StartLetter1:lower())
                local start2 = string.byte(Config.StartLetter2:lower())
                for char1 = start1, 122 do
                    local innerStart = (char1 == start1) and start2 or 97
                    for char2 = innerStart, 122 do
                        table.insert(worldsToVisit, string.char(char1) .. string.char(char2))
                    end
                end
            end

            worldsToVisit = dedup(worldsToVisit)
            Log("`2Total worlds in Auto Join queue: `0" .. #worldsToVisit)

            for i, worldName in ipairs(worldsToVisit) do
                if not Config.AutoJoinRunning then break end

                Log("`2Joining (`0" .. i .. "`2/`0" .. #worldsToVisit .. "`2): `0" .. worldName)
                RequestJoinWorld(worldName)
                Sleep(Config.JoinPacketDelay)

                local timeout = Config.JoinTimeoutSeconds
                while Config.AutoJoinRunning and timeout > 0 do
                    local currentWorld = GetWorld()
                    local localAvatar  = GetLocal()
                    if currentWorld and string.upper(currentWorld.name) == worldName and localAvatar then
                        break
                    end
                    Sleep(1000)
                    timeout = timeout - 1
                end

                if not Config.AutoJoinRunning then break end

                if timeout > 0 then
                    Sleep(500)
                    if Config.JoinPlaceAndLeave then
                        Log("`9Placing item " .. Config.JoinPlaceItem .. " above player...")
                        placeAbovePlayer(Config.JoinPlaceItem)
                        Sleep(Config.JoinPacketDelay)
                        SendPacket(3, "action|quit_to_exit")
                        Sleep(Config.JoinPacketDelay)
                    else
                        Log("`9Joined successfully. Waiting for Punch World to finish...")
                        -- Wait loop: stay here while Punch World clears out the world
                        -- or wait a default delay before jumping to next
                        Sleep(Config.JoinPacketDelay * 2) 
                    end
                else
                    Log("`4Skipped (timeout): `0" .. worldName)
                end
                Sleep(Config.JoinPacketDelay)
            end
            
            Config.AutoJoinRunning = false
            Log("`2Auto Join queue finished/stopped.")
        elseif not Config.AutoJoinRunning and prevRunning then
            prevRunning = false
        end
        Sleep(1000)
    end
end)

