function ScanMagplants()
    MagplantsList = {}
    currentMagplantIndex = 1
    local world = GetWorld()
    if not world then return end
    
    for x = 0, world.width - 1 do
        for y = 0, world.height - 1 do
            local fg = GetTile(x, y).fg
            if fg == 5638 or fg == 5930 then
                local kind = (fg == 5930) and "Legendary" or "Normal"
                table.insert(MagplantsList, {x = x, y = y, itemID = nil, amount = nil, kind = kind})
            end
        end
