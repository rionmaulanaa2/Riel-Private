-- Inventory helpers
local function GetItemCount(id, preFetchedInv)
    local inv = preFetchedInv or GetInventory()
    if not inv or type(inv) ~= "table" then return 0 end
    for _, itm in pairs(inv) do
        if type(itm) == "table" then
            local itmId = tonumber(itm.id or itm.itemid or itm.itemID or 0)
            local itmAmount = tonumber(itm.amount or itm.count or itm.itemCount or 0)
            if itmId == tonumber(id) then return itmAmount end
        elseif type(itm) == "number" and itm == tonumber(id) then return 1 end
    end
    return 0
end

local failedStashCounts = {}
local function CheckBackpack()
    if not Config.AutoBackpack or Paused or not Run then return end
    local inv = GetInventory()
    if not inv or type(inv) ~= "table" then return end
    local counts = {}
    for _, itm in pairs(inv) do
        if type(itm) == "table" then
            local itmId = tonumber(itm.id or itm.itemid or itm.itemID or 0)
            local itmAmount = tonumber(itm.amount or itm.count or itm.itemCount or 0)
            if itmId and itmId > 0 then counts[itmId] = (counts[itmId] or 0) + itmAmount end
        elseif type(itm) == "number" then counts[itm] = (counts[itm] or 0) + 1 end
    end
    for _, id in ipairs(Config.BackpackList) do
        local count = counts[id] or 0
        if count >= Config.AutoBackpackLimit then
            local failedTimes = failedStashCounts[id] or 0
            if failedTimes < 3 then
                Log("`9[Auto Backpack] `0Stashing ID `b" .. tostring(id) .. "`0 (" .. count .. "/" .. Config.AutoBackpackLimit .. ")")
                SendPacket(2, "action|dialog_return\ndialog_name|backpack_menu\nitemid|" .. tostring(id))
                Sleep(400)
                local newCount = GetItemCount(id)
                if newCount >= count then
                    failedStashCounts[id] = (failedStashCounts[id] or 0) + 1
                    if failedStashCounts[id] >= 3 then Log("`4[Auto Backpack] `0Storage full for ID `b" .. tostring(id) .. "`4! Disabling.`0"); Config.AutoBackpack = false; return end
                else failedStashCounts[id] = 0; Log("`2[Auto Backpack] `0Stashed ID `b" .. tostring(id) .. "`2. Remaining: " .. newCount) end
            end
        end
    end
end

local function IsInTakeList(id) for _, listId in ipairs(Config.TakeList) do if listId == id then return true end end return false end
local failedObjectPickups = {}
local function GetObjectKey(obj) if not obj then return "" end; if obj.oid then return tostring(obj.oid) end; local px = (obj.pos and obj.pos.x) or 0; local py = (obj.pos and obj.pos.y) or 0; return px .. "_" .. py .. "_" .. (obj.id or 0) end
local function GetDistance(x1, y1, x2, y2) return math.sqrt((x2 - x1)^2 + (y2 - y1)^2) end

local function CollectItems()
    local objs = GetObjectList()
    if not objs or type(objs) ~= "table" or next(objs) == nil then return end
    local validObjs = {}
    local local_ = GetLocal()
    local localPos = (local_ and type(local_.pos) == "table") and local_.pos or nil
    if not localPos then return end
    for _, obj in pairs(objs) do
        if type(obj) == "table" and type(obj.pos) == "table" then
            local key = GetObjectKey(obj)
            local fails = failedObjectPickups[key] or 0
            if fails < 3 then
                local shouldTake = not Config.UseTakeList
                if Config.UseTakeList and IsInTakeList(obj.id) then shouldTake = true end
                if shouldTake then
                    local dx = localPos.x - obj.pos.x; local dy = localPos.y - obj.pos.y
                    obj.distSq = dx * dx + dy * dy; obj.key = key
                    table.insert(validObjs, obj)
                end
            end
        end
    end
    if #validObjs == 0 then return end
    table.sort(validObjs, function(a, b) return a.distSq < b.distSq end)
    local moved = false
    for _, obj in ipairs(validObjs) do
        if Paused then break end
        local objX = math.floor(obj.pos.x / 32); local objY = math.floor(obj.pos.y / 32)
        local l = GetLocal()
        if l and type(l) == "table" and type(l.pos) == "table" then
            local currPos = l.pos; local currX = math.floor(currPos.x / 32); local currY = math.floor(currPos.y / 32)
            if currX ~= objX or currY ~= objY then
                if Config.TeleportToItems then FindPath(objX, objY, 0); Sleep(50) else FindPath(objX, objY, 100); Sleep(200) end
                moved = true
            end
        end
        local postObjs = GetObjectList(); local stillExists = false
        if postObjs then for _, pObj in pairs(postObjs) do if GetObjectKey(pObj) == obj.key then stillExists = true; break end end end
        if stillExists then failedObjectPickups[obj.key] = (failedObjectPickups[obj.key] or 0) + 1
            if failedObjectPickups[obj.key] >= 3 then Log("`4[Auto Take] `0Item uncollectable - skipping.") end
        end
        if Config.AutoBackpack then CheckBackpack() end
    end
    if moved and startX and startY and not Config.TeleportToItems then FindPath(startX, startY, 100); Sleep(200) end
end

