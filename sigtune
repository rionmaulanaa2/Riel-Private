-- AUTO PUNCH WORLD LOGIC
-- ============================================================
local punchWX, punchWY = nil, nil

local function AutoPunchWorldStep()
    local world = GetWorld()
    local tiles = GetTiles()
    if not world or not tiles then return end

    if punchWX == nil or punchWY == nil then
        punchWX = 0
        punchWY = 0
    end

    local grid = {}
    for _, t in pairs(tiles) do
        if not grid[t.x] then grid[t.x] = {} end
        grid[t.x][t.y] = t
    end

    local targetX, targetY = nil, nil

    while true do
        if punchWY >= world.height then break end

        local tile = grid[punchWX] and grid[punchWX][punchWY]
        
        if tile and tile.fg == Config.PunchWorldTarget then
            targetX = punchWX
            targetY = punchWY
            break
        end

        punchWX = punchWX + 1
        if punchWX >= world.width then
            punchWX = 0
            punchWY = punchWY + 1
        end
    end

    if targetX and targetY then
        -- Punch remotely (no movement)
        SendPacketRaw(false, {
            type = 3,
            value = Config.PunchWorldTarget,
            px = targetX,
            py = targetY,
            x = targetX * 32,
            y = targetY * 32
        })
    else
        local skipped = false
        for _, t in pairs(tiles) do
            if t.fg == Config.PunchWorldTarget then
                skipped = true
                break
            end
        end

        if skipped then
            Log("`6Found skipped blocks! Restarting world scan...`0")
            punchWX, punchWY = 0, 0
        else
            Log("`2Auto Punch World finished! Disabled.`0")
            Config.AutoPunchWorld = false
            punchWX = nil
        end
    end
end

