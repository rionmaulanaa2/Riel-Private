-- Helper function to calculate distance
local function GetDistance(x1, y1, x2, y2)
    return math.sqrt((x2 - x1)^2 + (y2 - y1)^2)
end

-- Collect floating items and return to start position
local function CollectItems()
    local objs = GetObjectList()
    if not objs then return end

    local validObjs = {}
    local localPos = GetLocal().pos

    for _, obj in pairs(objs) do
        local shouldTake = not Config.UseTakeList
        if Config.UseTakeList and IsInTakeList(obj.id) then
            shouldTake = true
        end
        if shouldTake then
            local dx = localPos.x - obj.pos.x
            local dy = localPos.y - obj.pos.y
            obj.distSq = dx * dx + dy * dy
            table.insert(validObjs, obj)
        end
    end

    -- Sort by squared distance to player (closest first)
    table.sort(validObjs, function(a, b) return a.distSq < b.distSq end)

    local moved = false
    for _, obj in ipairs(validObjs) do
        -- Abort immediately if a stranger enters while we are collecting
        if Paused then break end

        local objX = math.floor(obj.pos.x / 32)
        local objY = math.floor(obj.pos.y / 32)
        
        -- Only move if it's not on our exact current tile
        local currPos = GetLocal().pos
        local currX = math.floor(currPos.x / 32)
        local currY = math.floor(currPos.y / 32)
        
        if currX ~= objX or currY ~= objY then
            if Config.TeleportToItems then
                -- 0ms delay pathing (extremely fast walking, acts like teleport to server)
                FindPath(objX, objY, 0)
                Sleep(50)
            else
                FindPath(objX, objY, 100)
                Sleep(200)
            end
            moved = true
        end

        -- After picking up each item, check if backpack needs stashing
        if Config.AutoBackpack then
            CheckBackpack()
        end
    end

    if moved and startX and startY then
        -- Return to original position
        if Config.TeleportToItems then
            FindPath(startX, startY, 0)
            Sleep(50)
        else
            FindPath(startX, startY, 100)
            Sleep(300)
        end
    end
end

