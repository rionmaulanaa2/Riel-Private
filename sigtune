                Log("`2Generating BUY+<itemname> worlds...")
                local allItems = GetItemInfoList()
                if allItems then
                    local maxID = 0
                    for id, _ in pairs(allItems) do if type(id) == "number" and id > maxID then maxID = id end end
                    for id = Config.BuyItemStartID, maxID do
                        local item = allItems[id]
                        if item and item.name and item.name ~= "" and not item.name:match("^%d+$") then
                            local cleanName = item.name:upper():gsub("%s+", ""):gsub("[^%a%d]", "")
                            if #cleanName > 0 and #("BUY" .. cleanName) <= 24 then
                                table.insert(worldsToVisit, "BUY" .. cleanName)
                                if Config.JoinItemAcronymWorlds then
                                    for itemKey, acronyms in pairs(itemAcronyms) do
                                        if item.name:lower() == itemKey:lower() then
                                            for _, acronym in ipairs(acronyms) do table.insert(worldsToVisit, "BUY" .. acronym:upper()) end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end

            if Config.Join2LetterWorlds then
                Log("`2[AutoJoin] Generating 2-Letter worlds...")
                local fullSequence = {}
                
                -- 1. aa to zz
                for char1 = 97, 122 do
                    for char2 = 97, 122 do
                        table.insert(fullSequence, string.char(char1) .. string.char(char2))
                    end
                end

                -- 2. a0..a9 then 0a..9a then b0..b9 ...
                for char1 = 97, 122 do
                    for num = 48, 57 do
                        table.insert(fullSequence, string.char(char1) .. string.char(num))
                    end
                    for num = 48, 57 do
                        table.insert(fullSequence, string.char(num) .. string.char(char1))
                    end
                end

                -- 3. 00..99
                for num1 = 48, 57 do
                    for num2 = 48, 57 do
                        table.insert(fullSequence, string.char(num1) .. string.char(num2))
                    end
                end

                -- Filter based on Start2Letter
                local startStr = type(Config.Start2Letter) == "string" and Config.Start2Letter:lower() or "aa"
                if #startStr ~= 2 then startStr = "aa" end
                
                local foundStart = false
                for _, w in ipairs(fullSequence) do
                    if not foundStart and w == startStr then
                        foundStart = true
                    end
                    if foundStart then
                        table.insert(worldsToVisit, w)
                    end
                end
                
                -- Fallback if start string wasn't valid/found
                if not foundStart then
                    for _, w in ipairs(fullSequence) do
                        table.insert(worldsToVisit, w)
                    end
                end
            end

            if Config.Join3LetterWorlds then
                Log("`2[AutoJoin] Generating 3-Letter worlds (aaa-zzz)...")
                for c1 = 97, 122 do
                    for c2 = 97, 122 do
                        for c3 = 97, 122 do
                            table.insert(worldsToVisit, string.char(c1) .. string.char(c2) .. string.char(c3))
                        end
                    end
                end
            end

            if Config.Join4LetterWorlds then
                Log("`2[AutoJoin] Generating 4-Letter worlds (aaaa-zzzz)...")
                local count = 0
                for c1 = 97, 122 do
                    for c2 = 97, 122 do
                        for c3 = 97, 122 do
                            for c4 = 97, 122 do
                                table.insert(worldsToVisit, string.char(c1) .. string.char(c2) .. string.char(c3) .. string.char(c4))
                                count = count + 1
                                if count % 10000 == 0 then Sleep(10) end
                            end
                        end
                    end
                end
            end

            worldsToVisit = dedup(worldsToVisit)
            Log("`2Total worlds in Auto Join queue: `0" .. #worldsToVisit)

            for i, worldName in ipairs(worldsToVisit) do
                if not Config.AutoJoinRunning then break end

                Log("`2Joining (`0" .. i .. "`2/`0" .. #worldsToVisit .. "`2): `0" .. worldName)
                SendPacket(3, "action|join_request\nname|" .. worldName .. "\ninvitedWorld|0")
                Sleep(Config.JoinPacketDelay)

                local timeout = Config.JoinTimeoutSeconds
                while Config.AutoJoinRunning and timeout > 0 do
                    local currentWorld = GetWorld()
                    local localAvatar  = GetLocal()
                    if currentWorld and string.upper(currentWorld.name) == worldName and localAvatar then
                        break
                    end
                    Sleep(1000)
                    timeout = timeout - 1
                end

                if not Config.AutoJoinRunning then break end

                if timeout > 0 then
                    Sleep(500)
                    if Config.JoinPlaceAndLeave then
                        Log("`9Placing item " .. Config.JoinPlaceItem .. " above player...")
                        placeAbovePlayer(Config.JoinPlaceItem)
                        Sleep(Config.JoinPacketDelay)
                        SendPacket(3, "action|quit_to_exit")
                        Sleep(Config.JoinPacketDelay)
                    else
                        Log("`9Joined successfully. Waiting for Punch World to finish...")
                        -- Wait loop: stay here while Punch World clears out the world
                        -- or wait a default delay before jumping to next
                        Sleep(Config.JoinPacketDelay * 2) 
                    end
                else
                    Log("`4Skipped (timeout): `0" .. worldName)
                end
                Sleep(Config.JoinPacketDelay)
            end
            
            Config.AutoJoinRunning = false
            Log("`2Auto Join queue finished/stopped.")
        elseif not Config.AutoJoinRunning and prevRunning then
            prevRunning = false
        end
        Sleep(1000)
    end
end)

