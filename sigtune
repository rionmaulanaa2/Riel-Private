AddHook("onsendpacket", "DebugPacketLogger", function(type, data)
    if not Config.DebugSendPacket then return false end

    if type == 2 or type == 3 then
        local out = "SendPacket" .. GetTimeStr() .. "\n"
        out = out .. "type " .. type .. ": " .. tostring(data)
        
        Log("`bSendPacket`0 (type " .. type .. ") logged to WH")
        SendToWebhook(out)
    end
    return false
end)

