-- ============================================================
-- CLEAR WORLD & WATER LOGIC
-- ============================================================
local clearWX, clearWY = nil, nil
local clearWGrid = nil
local clearWGridW, clearWGridH = 0, 0
local clearWWorld = nil

local function BuildClearGrid()
    local tiles = GetTiles()
    local world = GetWorld()
    if not tiles or not world then return false end
    clearWGrid = {}
    for _, t in pairs(tiles) do
        if not clearWGrid[t.x] then clearWGrid[t.x] = {} end
        clearWGrid[t.x][t.y] = {fg = t.fg, bg = t.bg, flags = t.flags}
    end
    clearWWorld = world.name
    clearWGridW = world.width
    clearWGridH = world.height
    return true
end

local function InitializeClear()
    local world = GetWorld()
    if not world then return end
    if Config.ClearDirection == "top" then
        clearWY = 0
    else
        clearWY = world.height - 1
    end
    clearWX = 0
    clearWGrid = nil
    clearWWorld = nil
end

local function ClearWorldStep()
    local world = GetWorld()
    if not world then return end

    if clearWX == nil or clearWY == nil then
        InitializeClear()
    end

    if clearWGrid == nil or clearWWorld ~= world.name then
        if not BuildClearGrid() then return end
    end

    local targetX, targetY = nil, nil

    while true do
        if Config.ClearDirection == "top" and clearWY >= clearWGridH then break end
        if Config.ClearDirection == "bottom" and clearWY < 0 then break end

        local cell = clearWGrid[clearWX] and clearWGrid[clearWX][clearWY]
        if cell then
            if (cell.fg ~= 0 or cell.bg ~= 0) and not Config.ClearIgnoreBlocks[cell.fg] then
                targetX = clearWX
                targetY = clearWY
                break
            end
        end

        clearWX = clearWX + 1
        if clearWX >= clearWGridW then
            clearWX = 0
            clearWY = Config.ClearDirection == "top" and (clearWY + 1) or (clearWY - 1)
        end
    end

    if targetX and targetY then
        while (GetTile(targetX, targetY).fg ~= 0 or GetTile(targetX, targetY).bg ~= 0) and not Config.ClearIgnoreBlocks[GetTile(targetX, targetY).fg] do
            if not Run or Paused or not Config.AutoClearWorld then return end -- Abort if paused by stranger or manually disabled
            SendPacketRaw(false, {
                type  = 3,
                value = 18,
                px    = targetX,
                py    = targetY,
                x     = targetX * 32,
                y     = targetY * 32
            })
            Sleep(Config.ClearDelay)
        end

        clearWGrid[targetX][targetY].fg = 0
        clearWGrid[targetX][targetY].bg = 0
        
        clearWX = targetX + 1
        if clearWX >= clearWGridW then
            clearWX = 0
            clearWY = Config.ClearDirection == "top" and (targetY + 1) or (targetY - 1)
        end
    else
        Log("`2Auto Clear World finished!`0")
        Config.AutoClearWorld = false
        clearWX = nil
        clearWGrid = nil
    end
end

local function ClearWaterStep()
    local world = GetWorld()
    if not world then return end

    if clearWX == nil or clearWY == nil then
        InitializeClear()
    end

    if clearWGrid == nil or clearWWorld ~= world.name then
        if not BuildClearGrid() then return end
    end

    local targetX, targetY = nil, nil

    while true do
        if Config.ClearDirection == "top" and clearWY >= clearWGridH then break end
        if Config.ClearDirection == "bottom" and clearWY < 0 then break end

        local cell = clearWGrid[clearWX] and clearWGrid[clearWX][clearWY]
        if cell and cell.flags and cell.flags.water then
            targetX = clearWX
            targetY = clearWY
            break
        end

        clearWX = clearWX + 1
        if clearWX >= clearWGridW then
            clearWX = 0
            clearWY = Config.ClearDirection == "top" and (clearWY + 1) or (clearWY - 1)
        end
    end

    if targetX and targetY then
        while GetTile(targetX, targetY).flags and GetTile(targetX, targetY).flags.water do
            if not Run or Paused or not Config.AutoClearWater then return end
            SendPacketRaw(false, {
                type  = 3,
                value = Config.ClearSpongeID,
                px    = targetX,
                py    = targetY,
                x     = targetX * 32,
                y     = targetY * 32
            })
            Sleep(Config.ClearDelay)
        end

        if clearWGrid[targetX] and clearWGrid[targetX][targetY] and clearWGrid[targetX][targetY].flags then
            clearWGrid[targetX][targetY].flags.water = false
        end
        
        clearWX = targetX + 1
        if clearWX >= clearWGridW then
            clearWX = 0
            clearWY = Config.ClearDirection == "top" and (targetY + 1) or (targetY - 1)
        end
    else
        Log("`2Auto Clear Water finished!`0")
        Config.AutoClearWater = false
        clearWX = nil
        clearWGrid = nil
    end
end

-- ============================================================
-- MAIN PUNCH LOOP
-- ============================================================

Log("Script loaded! Target tile: (" .. Config.TileX .. ", " .. Config.TileY .. ")")
Log("Punching with ItemID: " .. Config.ItemID)
Log("Type `4/stop`9 to stop the script.")

local punchCount = 0

-- Wait for world to load first, but allow breaking out if UI toggles Run
while true do
    if Run and not Paused then
        if not GetLocal() or not GetWorld() then
            Sleep(500)
        else
            -- Check start position once world is loaded
            if not startX then
                startX = math.floor(GetLocal().pos.x / 32)
                startY = math.floor(GetLocal().pos.y / 32)
                Log("World detected: `e" .. GetWorld().name)
            end

            -- Determine the correct delay based on the active mode
            local currentDelay = Config.PunchDelay

            if Config.AutoClearWorld then
                ClearWorldStep()
                currentDelay = Config.ClearDelay
            elseif Config.AutoClearWater then
                ClearWaterStep()
                currentDelay = Config.ClearDelay
            elseif Config.AutoPlace then
                AutoPlaceStep()
                currentDelay = Config.PlaceDelay
            elseif Config.AutoPunchWorld then
                AutoPunchWorldStep()
                currentDelay = Config.PunchWorldDelay
            else
                if Config.AutoPunch then
                    PunchTile()
                end
            end
            punchCount = punchCount + 1
            
            if Config.AutoTake and (punchCount % 10 == 0) then
                CollectItems()
            end

            if Config.AutoBackpack and (punchCount % 20 == 0) then
                CheckBackpack()
            end
            
            Sleep(currentDelay)
        end
    else
        Sleep(100)
    end
end
