-- DISCORD WEBHOOK QUEUE WORKER
-- ============================================================
local debugWebhookQueue = {}

-- Helper to safely get time without crashing if OS lib is missing in sandbox
local function GetTimeStr()
    local t = ""
    pcall(function()
        if os and os.date then
            t = " " .. os.date("[%H:%M:%S]")
        end
    end)
    return t
end

local function SendToWebhook(title, description, color, ignoreConfig)
    if not ignoreConfig and not (Config.DebugSendPacket or Config.DebugSendPacketRaw or Config.DebugVariant) then
        return
    end
    if Config.DebugWebhookURL == "" or not MakeRequest then return end

    local function esc(s)
        s = tostring(s)
        s = s:gsub("\\", "\\\\")
        s = s:gsub('"', '\\"')
        s = s:gsub("\r", "")
        s = s:gsub("\n", "\\n")
        s = s:gsub("\t", " ")
        return s
    end

    local world   = GetWorld and GetWorld() or nil
    local local_  = GetLocal and GetLocal() or nil
    local worldName  = world  and world.name  or "Unknown"
    local playerName = local_ and local_.name or "Unknown"

    title       = esc(title or "Packet Debugger")
    description = esc(description or "")
    color       = tonumber(color) or 16776960

    if #description > 1900 then description = description:sub(1, 1900) end
    local body = '{"embeds":[{"title":"' .. title ..
                 '","description":"' .. description ..
                 '","color":' .. tostring(color) ..
                 ',"footer":{"text":"Player: ' .. esc(playerName) ..
                 ' | World: ' .. esc(worldName) .. '"}}]}'

    -- Prevent unlimited memory growth: cap queue size to 300
    if #debugWebhookQueue >= 300 then
        table.remove(debugWebhookQueue, 1)
    end

    -- Push payload to pending queue
    table.insert(debugWebhookQueue, {
        url = Config.DebugWebhookURL,
        body = body,
        ignoreConfig = ignoreConfig
    })
end

-- Dedicated Webhook Worker Thread: process ALL pending queued debugs sequentially
RunThread(function()
    while currentSessionID == _G.SafePunchSessionID do
        if #debugWebhookQueue > 0 then
            local job = table.remove(debugWebhookQueue, 1)
            if job and job.url and job.url ~= "" then
                pcall(function()
                    MakeRequest(job.url, "POST", {["Content-Type"]="application/json"}, job.body)
                end)
                local cooldown = (job.ignoreConfig and 500) or math.max(500, Config.DebugRateLimit or 2000)
                Sleep(cooldown)
            else
                Sleep(100)
            end
        else
            Sleep(200)
        end
    end
end)

