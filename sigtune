-- Correct tool ID -> name mapping (verified from working script)
local SURG_TOOL_IDS = {
    [1258] = "Sponge",
    [1260] = "Scalpel",
    [1262] = "Anesthetic",
    [1266] = "Antibiotic",
    [1268] = "Splint",
