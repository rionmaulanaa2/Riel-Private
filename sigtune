            local t = SafeGetTile(targetX, targetY)
            if not IsWaterTile(t) then break end
            SendPacketRaw(false, {type = 3, value = Config.ClearSpongeID, px = targetX, py = targetY, x = targetX * 32, y = targetY * 32})
            Sleep(Config.ClearDelay); hits = hits + 1
        until hits >= 20
        waterCX = targetX + 1
        if waterCX >= world.width then waterCX = 0; waterCY = Config.ClearDirection == "top" and (targetY + 1) or (targetY - 1) end
    else
        Log("`2[Clear Water] `0Finished! Enabling cleanup...")
        Config.AutoClearWater = false; waterCX, waterCY = nil, nil
        Config.AutoBackpack = true; Config.AutoTake = true; Config.TeleportToItems = true; autoClearWorldCleanupState = true
