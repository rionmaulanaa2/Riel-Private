-- Helper function to check inventory count of an item
local function GetItemCount(id)
    local inv = GetInventory()
    if not inv then return 0 end
    for _, itm in pairs(inv) do
        if itm.id == id then
            return itm.amount
        end
    end
    return 0
end

-- Check inventory and stash to backpack if needed
local failedStashCounts = {}

local function CheckBackpack()
    if not Config.AutoBackpack or Paused or not Run then return end

    local inv = GetInventory()
    if not inv then return end

    for _, id in ipairs(Config.BackpackList) do
        local count = GetItemCount(id)
        if count >= Config.AutoBackpackLimit then
            local failedTimes = failedStashCounts[id] or 0
            if failedTimes < 3 then
                Log("`9[Auto Backpack] `0Inventory limit reached (" .. count .. "/" .. Config.AutoBackpackLimit .. ") for ID `b" .. tostring(id) .. "`0. Stashing...")
                
                SendPacket(2, "action|dialog_return\ndialog_name|backpack_menu\nitemid|" .. tostring(id))
                Sleep(400)

                -- Verify if inventory count actually decreased
                local newCount = GetItemCount(id)
                if newCount >= count then
                    -- Count did not decrease -> stash failed!
                    failedStashCounts[id] = (failedStashCounts[id] or 0) + 1
                    if failedStashCounts[id] >= 3 then
                        Log("`4[Auto Backpack] Storage full or Item ID `b" .. tostring(id) .. "`4 cannot be stashed! Disabling Auto Backpack to prevent lag.`0")
                        Config.AutoBackpack = false
                        return
                    end
                else
                    -- Stash succeeded! Reset fail count for this item
                    failedStashCounts[id] = 0
                    Log("`2[Auto Backpack] `0Successfully stashed ID `b" .. tostring(id) .. "`0. Remaining: " .. newCount)
                end
            end
        end
    end
end

