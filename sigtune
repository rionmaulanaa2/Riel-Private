-- Returns true if a userid is in the whitelist or is the local player
local function IsWhitelisted(userid)
    local local_ = GetLocal()
    if local_ and local_.userid and tonumber(local_.userid) == tonumber(userid) then return true end
    for _, uid in ipairs(Config.Whitelist) do
        if tonumber(uid) == tonumber(userid) then return true end
    end
    return false
end

-- ============================================================
-- MOD / DEVELOPER DETECTION (invisible entry)
-- ============================================================
-- Developers and Moderators can enter invisible (not in GetPlayerList).
-- They trigger an OnSpawn variant where their properties are sent.

AddHook("onvariant", "ModDevDetector", function(var)
    if var[0] == "OnSpawn" then
        local spawnData = tostring(var[1] or "")
        -- Check for Developer/Moderator type flags or invisible states
        local typeVal = tonumber(spawnData:match("type|(%d+)"))
        local isMod = typeVal and ((typeVal & 4) ~= 0)
        local isDev = typeVal and ((typeVal & 8) ~= 0)
        
        -- Also check for invis/mstate flags that might indicate staff
        local isInvis = spawnData:find("invis|1") or spawnData:find("mstate|1")
        
        local name = spawnData:match("name|([^\n]+)") or "Unknown"
        local userid = tonumber(spawnData:match("userID|(%d+)"))
        
        -- We ignore our own spawn packet (Growtopia sends local|1 for the local player)
        if spawnData:find("\nlocal|1\n") or spawnData:find("local|1") then
            return false
        end
        
        -- Fallback local player check using userid
        local local_ = GetLocal()
        if local_ and local_.userid and userid == local_.userid then
            return false
        end
        
        -- Also ignore if they are in our whitelist (so you can whitelist your mod friends)
        if userid and IsWhitelisted(userid) then
            return false
        end

        if isMod or isDev or isInvis then
            local role = isDev and "`4[DEVELOPER]" or (isMod and "`6[MODERATOR]" or "`b[INVISIBLE STAFF]")
            Log("`4ALL FEATURES PAUSED! " .. role .. "`0 detected entering world: `e" .. name)
            modDetected = true
            Paused = true
            Run = false
        end
    end
    
    -- Handle Backpack Resupply UI parsing
    if var[0] == "OnDialogRequest" and waitingForBackpackItem and type(var[1]) == "string" and var[1]:find("backpack_menu") then
        local dialog = var[1]
        local itemIDStr = tostring(waitingForBackpackItem)
        -- Match: add_button_with_icon|<SLOT>|<Name>|frame|<ITEM_ID>|<AMOUNT>|
        local pattern = "add_button_with_icon|(%d+)|[^|]*|frame|" .. itemIDStr .. "|"
        local slot = dialog:match(pattern)
        
        if slot then
            SendPacket(2, "action|dialog_return\ndialog_name|backpack_menu\nbuttonClicked|" .. slot)
            Log("`2Resupplied item `b" .. itemIDStr .. "`2 from backpack slot `b" .. slot .. "`0")
        else
            Log("`4Item `b" .. itemIDStr .. "`4 not found in backpack! Pausing AutoPlace.`0")
            Config.AutoPlace = false
        end
        
        waitingForBackpackItem = nil
        return true -- Block the dialog from showing on screen
    end
    
    return false
end)

-- Get a table of current players (excluding local player), keyed by netid
local function GetOtherPlayers()
    local players = {}
    local local_ = GetLocal()
    if not local_ then return players end

    local list = GetPlayerList()
    if not list then return players end

    for _, p in pairs(list) do
        if p then
            local isLocal = false
            if p.netid == local_.netid then isLocal = true end
            if p.userid and local_.userid and tonumber(p.userid) == tonumber(local_.userid) then isLocal = true end
            if p.name and local_.name and p.name == local_.name then isLocal = true end

            if not isLocal then
                players[p.netid] = { name = p.name, userid = p.userid }
            end
        end
    end
    return players
end

-- Punch the target tile once
local function PunchTile()
    SendPacketRaw(false, {
        type  = 3,
        value = Config.ItemID,
        px    = Config.TileX,
        py    = Config.TileY,
        x     = Config.TileX * 32,
        y     = Config.TileY * 32,
    })
end

-- Helper function to check inventory count of an item
local function GetItemCount(id)
    local inv = GetInventory()
    if not inv then return 0 end
    for _, itm in pairs(inv) do
        if itm.id == id then
            return itm.amount
        end
    end
    return 0
end

-- Check inventory and stash to backpack if needed
local function CheckBackpack()
    if not Config.AutoBackpack then return end
    
    for _, id in ipairs(Config.BackpackList) do
        if GetItemCount(id) >= Config.AutoBackpackLimit then
            Log("Inventory full! Stashing ID `b" .. tostring(id) .. "`0 to backpack...")
            SendPacket(2, "action|dialog_return\ndialog_name|backpack_menu\nitemid|" .. tostring(id))
            Sleep(500) -- Delay to prevent packet spam
        end
    end
end

-- Helper function to check if item is in take list
local function IsInTakeList(id)
    for _, listId in ipairs(Config.TakeList) do
        if listId == id then return true end
    end
    return false
end

-- Helper function to calculate distance
local function GetDistance(x1, y1, x2, y2)
    return math.sqrt((x2 - x1)^2 + (y2 - y1)^2)
end

-- Collect floating items and return to start position
local function CollectItems()
    local objs = GetObjectList()
    if not objs then return end

    local validObjs = {}
    local localPos = GetLocal().pos

    for _, obj in pairs(objs) do
        local shouldTake = not Config.UseTakeList
        if Config.UseTakeList and IsInTakeList(obj.id) then
            shouldTake = true
        end
        if shouldTake then
            table.insert(validObjs, obj)
        end
    end

    -- Sort by distance to player (closest first)
    table.sort(validObjs, function(a, b)
        return GetDistance(localPos.x, localPos.y, a.pos.x, a.pos.y) < GetDistance(localPos.x, localPos.y, b.pos.x, b.pos.y)
    end)

    local moved = false
    for _, obj in ipairs(validObjs) do
        -- Abort immediately if a stranger enters while we are collecting
        if Paused then break end

        local objX = math.floor(obj.pos.x / 32)
        local objY = math.floor(obj.pos.y / 32)
        
        -- Only move if it's not on our exact current tile
        local currPos = GetLocal().pos
        local currX = math.floor(currPos.x / 32)
        local currY = math.floor(currPos.y / 32)
        
        if currX ~= objX or currY ~= objY then
            if Config.TeleportToItems then
                -- 0ms delay pathing (extremely fast walking, acts like teleport to server)
                FindPath(objX, objY, 0)
                Sleep(50)
            else
                FindPath(objX, objY, 100)
                Sleep(200)
            end
            moved = true
        end

        -- After picking up each item, check if backpack needs stashing
        if Config.AutoBackpack then
            CheckBackpack()
        end
    end

    if moved and startX and startY then
        -- Return to original position
        if Config.TeleportToItems then
            FindPath(startX, startY, 0)
            Sleep(50)
        else
            FindPath(startX, startY, 100)
            Sleep(300)
        end
    end
end

