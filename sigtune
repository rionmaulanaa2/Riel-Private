-- ============================================================
local clearWX, clearWY = nil, nil
local clearWGrid    = nil
local clearWGridW, clearWGridH = 0, 0
local clearWWorld   = nil
local clearWVisited = {}  -- tracks tiles already fully processed (key: x*10000+y)
local lastClearRowY = nil  -- tracks last row we teleported to for ClearWorldTeleportRow

local function BuildClearGrid()
    local tiles = GetTiles()
    local world = GetWorld()
    if not tiles or not world then return false end
    clearWGrid = {}
    for _, t in pairs(tiles) do
        if not clearWGrid[t.x] then clearWGrid[t.x] = {} end
        clearWGrid[t.x][t.y] = {fg = t.fg, bg = t.bg, flags = t.flags}
    end
    clearWWorld = world.name
    clearWGridW = world.width
    clearWGridH = world.height
    return true
end

local function InitializeClear()
    local world = GetWorld()
    if not world then return end
    if Config.ClearDirection == "top" then
        clearWY = 0
    else
        clearWY = world.height - 1
    end
    clearWX      = 0
    clearWGrid   = nil
    clearWWorld  = nil
    clearWVisited = {}  -- reset visited set on fresh start
    lastClearRowY = nil  -- reset row teleport tracker
    Log("`9[Clear World] `0Initialized. Ignored block IDs: 6,8,242,1796,5638,5930,7188,8470,10266,21220 + others.")
end

local function ClearWorldStep()
    local world = GetWorld()
    if not world then return end

    if clearWX == nil or clearWY == nil then
        InitializeClear()
    end

    local targetX, targetY = nil, nil

    while true do
        if Config.ClearDirection == "top" and clearWY >= world.height then break end
        if Config.ClearDirection == "bottom" and clearWY < 0 then break end

        local key  = clearWX * 10000 + clearWY
        local cell = GetTile(clearWX, clearWY)
        if cell and not clearWVisited[key] then
            -- skip ignored blocks AND bg-only ignored IDs
            local skipFg = Config.ClearIgnoreBlocks[cell.fg]
            local skipBg = Config.ClearIgnoreBlocks[cell.bg]
            if (cell.fg ~= 0 or cell.bg ~= 0) and not skipFg and not skipBg then
                targetX = clearWX
                targetY = clearWY
                break
            end
        end

        clearWX = clearWX + 1
        if clearWX >= world.width then
            clearWX = 0
            clearWY = Config.ClearDirection == "top" and (clearWY + 1) or (clearWY - 1)
        end
    end

    if targetX and targetY then
        -- Teleport to X=0 of the current row when the row changes
        if Config.ClearWorldTeleportRow and lastClearRowY ~= targetY then
            lastClearRowY = targetY
            SendPacketRaw(false, {
                type = 0,
                x    = 0,
                y    = targetY * 32,
                px   = 0,
                py   = 0
            })
            Log("`2[Clear World] `0Teleported to X=0 row Y=" .. targetY)
            Sleep(200)
        end

        -- Punch until tile is clear or we hit an ignored block / abort condition
        local maxHits = 60  -- safety cap per tile
        local hits = 0
        repeat
            if not Run or Paused or not Config.AutoClearWorld then return end
            local t = GetTile(targetX, targetY)
            if not t then break end
            if Config.ClearIgnoreBlocks[t.fg] or Config.ClearIgnoreBlocks[t.bg] then break end
            if t.fg == 0 and t.bg == 0 then break end
            SendPacketRaw(false, {
                type  = 3,
                value = 18,
                px    = targetX,
                py    = targetY,
                x     = targetX * 32,
                y     = targetY * 32
            })
            Sleep(Config.ClearDelay)
            hits = hits + 1
        until hits >= maxHits

        -- Mark tile as visited so we never retry it
        clearWVisited[targetX * 10000 + targetY] = true

        -- Advance cursor
        clearWX = targetX + 1
        if clearWX >= world.width then
            clearWX = 0
            clearWY = Config.ClearDirection == "top" and (targetY + 1) or (targetY - 1)
        end
    else
        Log("`2[Auto Clear World] `0Finished clearing world! Tiles skipped: " .. tostring(#clearWVisited or 0))
        Config.AutoClearWorld = false
        clearWX, clearWY = nil, nil
        clearWVisited = {}
    end
end

-- Separate cursor for Clear Water (independent from ClearWorld cursor)
local waterCX, waterCY = nil, nil

local function IsWaterTile(cell)
    if not cell then return false end

    -- Skip water on bedrock (ID 8) or any ignored block ID
    if cell.fg == 8 or cell.bg == 8 then return false end
    if Config.ClearIgnoreBlocks and (Config.ClearIgnoreBlocks[cell.fg] or Config.ClearIgnoreBlocks[cell.bg]) then
        return false
    end

    -- Direct property check (if exposed by Bothax API)
    if cell.water == true or cell.water == 1 then return true end

    -- Table flags check
    if type(cell.flags) == "table" then
        if cell.flags.water == true or cell.flags.water == 1 then return true end
    end

    -- Numeric bitmask check (Growtopia tile flags bit 0x40 / 0x80 / 0x200)
    if type(cell.flags) == "number" then
        if (cell.flags & 0x0040) ~= 0 or (cell.flags & 0x0080) ~= 0 or (cell.flags & 0x0200) ~= 0 then
            return true
        end
    end

    return false
end

local function InitializeClearWater()
    local world = GetWorld()
    if not world then return end
    if Config.ClearDirection == "top" then
        waterCY = 0
    else
        waterCY = world.height - 1
    end
    waterCX = 0
    Log("`9[Clear Water] `0Initialized. Scanning for water tiles with Sponge ID: " .. tostring(Config.ClearSpongeID))
end

local function ClearWaterStep()
    local world = GetWorld()
    if not world then return end

    if waterCX == nil or waterCY == nil then
        InitializeClearWater()
    end

    local targetX, targetY = nil, nil

    -- Scan for next water tile
    while true do
        if Config.ClearDirection == "top"    and waterCY >= world.height then break end
        if Config.ClearDirection == "bottom" and waterCY < 0             then break end

        local cell = GetTile(waterCX, waterCY)
        if cell and IsWaterTile(cell) then
            targetX = waterCX
            targetY = waterCY
            break
        end

        waterCX = waterCX + 1
        if waterCX >= world.width then
            waterCX = 0
            waterCY = Config.ClearDirection == "top" and (waterCY + 1) or (waterCY - 1)
        end
    end

    if targetX and targetY then
        -- Spray sponge until water is gone (max 20 hits per tile)
        local hits = 0
        repeat
            if not Run or Paused or not Config.AutoClearWater then return end
            local t = GetTile(targetX, targetY)
            if not t or not IsWaterTile(t) then break end
            SendPacketRaw(false, {
                type  = 3,
                value = Config.ClearSpongeID,
                px    = targetX,
                py    = targetY,
                x     = targetX * 32,
                y     = targetY * 32
            })
            Sleep(Config.ClearDelay)
            hits = hits + 1
        until hits >= 20

        -- Advance cursor past this tile
        waterCX = targetX + 1
        if waterCX >= world.width then
            waterCX = 0
            waterCY = Config.ClearDirection == "top" and (waterCY + 1) or (waterCY - 1)
        end
    else
        Log("`2[Auto Clear Water] `0Finished clearing all water tiles!")
        Config.AutoClearWater = false
        waterCX, waterCY = nil, nil
    end
end


-- ============================================================
-- MAIN PUNCH LOOP
-- ============================================================

Log("Script loaded! Target tile: (" .. Config.TileX .. ", " .. Config.TileY .. ")")
Log("Punching with ItemID: " .. Config.ItemID)
Log("Type `4/stop`9 to stop the script.")

local punchCount = 0

-- Main loop execution guard
while currentSessionID == _G.SafePunchSessionID and Run do
    -- Process pending UI action requests (prevents yielding across C-call boundary in OnDraw)
    if pendingGoToTarget then
        local target = pendingGoToTarget
        pendingGoToTarget = nil
        GoToMagplant(target.mx, target.my)
    end

    if pendingScanInfo then
        pendingScanInfo = false
        ScanMagplantInfo()
    end

    if not Paused then
        if not GetLocal() or not GetWorld() then
            Sleep(500)
        else
            -- Check start position once world is loaded
            if not startX then
                startX = math.floor(GetLocal().pos.x / 32)
                startY = math.floor(GetLocal().pos.y / 32)
                Log("World detected: `e" .. GetWorld().name)
            end

            -- Determine the correct delay based on the active mode
            local currentDelay = Config.PunchDelay

            if Config.AutoClearWorld then
                ClearWorldStep()
                currentDelay = Config.ClearDelay
            elseif Config.AutoClearWater then
                ClearWaterStep()
                currentDelay = Config.ClearDelay
            elseif Config.AutoPlace then
                AutoPlaceStep()
                currentDelay = Config.PlaceDelay
            elseif Config.AutoCreateFarm then
                AutoCreateFarmStep()
                currentDelay = Config.CreateFarmDelay
            elseif Config.AutoPunchWorld then
                AutoPunchWorldStep()
                currentDelay = Config.PunchWorldDelay
            elseif Config.AutoHarvest then
                AutoHarvestStep()
                currentDelay = Config.HarvestDelay
            else
                if Config.AutoPunch then
                    PunchTile()
                end
            end
            punchCount = punchCount + 1
            
            if Config.AutoTake and (punchCount % 10 == 0) then
                CollectItems()
            end

            if Config.AutoBackpack and (punchCount % 20 == 0) then
                CheckBackpack()
            end
            
            Sleep(currentDelay)
        end
    else
        Sleep(100)
    end
end

-- Exit cleanup when main loop ends or script is stopped
if _G.SafePunchSessionID == currentSessionID then
    pcall(RemoveHooks)
    Log("`4[SafePunch] Script loop exited. All hooks and background threads cleaned up.`0")
end
