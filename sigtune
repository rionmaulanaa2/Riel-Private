-- Deep-scan each magplant: wrench it, wait for dialog, read itemID + amount
function ScanMagplantInfo()
    if magplantScanInfoRunning then
        Log("`4[Magplant Scan] Already scanning! Please wait.`0")
        return
    end
    if #MagplantsList == 0 then
        ScanMagplants()
    end
    if #MagplantsList == 0 then
        Log("`4[Magplant Scan] No magplants found in world.`0")
        return
    end
    RunThread(function()
        magplantScanInfoRunning = true
        Log("`2[Magplant Scan] Starting deep scan of `b" .. #MagplantsList .. "`2 magplants...`0")
        for i, m in ipairs(MagplantsList) do
            if not Run or Paused then break end
            Log("`9[Magplant Scan] Wrenching magplant " .. i .. "/" .. #MagplantsList .. " at (" .. m.x .. "," .. m.y .. ")`0")
            magplantDialogReceived = false
            -- Send exact wrench packet: type=3, value=32 (wrench action)
            SendPacketRaw(false, {
                type    = 3,
                value   = 32,
                px      = m.x,
                py      = m.y,
                x       = m.x * 32,
                y       = m.y * 32,
                state   = 16
            })
            -- Wait up to 2000ms for the dialog to arrive
            local waited = 0
            while not magplantDialogReceived and waited < 2000 do
                Sleep(100)
                waited = waited + 100
            end
            if not magplantDialogReceived then
                Log("`4[Magplant Scan] No dialog response from magplant at (" .. m.x .. "," .. m.y .. ") — skipping.`0")
            end
            Sleep(300)  -- brief pause between magplants
        end
        magplantScanInfoRunning = false
        Log("`2[Magplant Scan] Deep scan complete!`0")
    end)
end

local function AutoMagplantStep()
    if not Config.AutoMagplant then return end
    if currentMagplantIndex > #MagplantsList then
        Log("`2[Auto Magplant] All magplants processed! Stopping.`0")
        Config.AutoMagplant = false
        return
    end
    
    local m = MagplantsList[currentMagplantIndex]
    
    -- Wrench magplant to open dialog (this updates itemID and amount asynchronously via OnVariant)
    SendPacketRaw(false, {type = 3, value = 32, px = m.x, py = m.y, x = m.x * 32, y = m.y * 32})
    Sleep(Config.MagplantDelay)
    
    if not Run or Paused or not Config.AutoMagplant then return end
    
    -- If amount is 0 (or was updated to 0), skip to next
    if m.amount and m.amount == 0 then
        Log("`4[Auto Magplant] Magplant at " .. m.x .. "," .. m.y .. " is empty! Moving to next.`0")
        currentMagplantIndex = currentMagplantIndex + 1
        return
    end
    
    -- Attempt retrieve
    SendPacket(2, "action|dialog_return\ndialog_name|itemsucker_block\ntilex|" .. m.x .. "|\ntiley|" .. m.y .. "|\nbuttonClicked|retrieveitem\n\nchk_enablesucking|1\n")
    Sleep(Config.MagplantDelay)
    
    if not Run or Paused or not Config.AutoMagplant then return end
    
    SendPacket(2, "action|dialog_return\ndialog_name|itemremovedfromsucker\ntilex|" .. m.x .. "|\ntiley|" .. m.y .. "|\nitemtoremove|250\n")
    Sleep(Config.MagplantDelay)
    
    -- Stash to backpack if we know the item ID
    if m.itemID then
        SendPacket(2, "action|dialog_return\ndialog_name|backpack_menu\nitemid|" .. tostring(m.itemID))
        Sleep(Config.MagplantDelay)
    end
end

