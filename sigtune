l delay = 0\n        if lastPacketTime > 0 then\n            delay = math.floor((now - lastPacketTime) * 1000)\n        end\n        lastPacketTime = now\n        \n        local safeStr = packet:gsub("\n", "\n")\n        table.insert(recordData, {delay = delay, data = "STR|" .. type .. "|" .. safeStr})\n    end\n    return false\nend)\n\nAddHook("onsendpacketraw", "RecordRawHook", function(packet)\n    if isRecording and packet then\n        local now = os.clock()\n        local delay = 0\n        if lastPacketTime > 0 then\n            delay = math.floor((now - lastPacketTime) * 1000)\n        end\n        lastPacketTime = now\n        \n        local rawStr = string.format("RAW|%d|%d|%d|%d|%d|%d", packet.type or 0, packet.value or 0, packet.px or 0, packet.py or 0, packet.x or 0, packet.y or 0)\n        table.insert(recordData, {delay = delay, data = rawStr})\n    end\n    return false\nend)\n\n-- ============================================================\n-- CLEAR WORLD & WATER LOGIC\n-- ============================================================\nlocal clearWX, clearWY = nil, nil\nlocal clearWGrid = nil\nlocal clearWGridW, clearWGridH = 0, 0\nlocal clearWWorld = nil\n\nlocal function BuildClearGrid()\n    local tiles = GetTiles()\n    local world = GetWorld()\n    if not tiles or not world then return false end\n    clearWGrid = {}\n    for _, t in pairs(tiles) do\n        if not clearWGrid[t.x] then clearWGrid[t.x] = {} end\n        clearWGrid[t.x][t.y] = {fg = t.fg, bg = t.bg, flags = t.flags}\n    end\n    clearWWorld = world.name\n    clearWGridW = world.width\n    clearWGridH = world.height\n    return true\nend\n\nlocal function InitializeClear()\n    local world = GetWorld()\n    if not world then return end\n    if Config.ClearDirection == "top" then\n        clearWY = 0\n    else\n        clearWY = world.height - 1\n    end\n    clearWX = 0\n    clearWGrid = nil\n    clearWWorld = nil\nend\n\nlocal function ClearWorldStep()\n    local world = GetWorld()\n    if not world then return end\n\n    if clearWX == nil or clearWY == nil then\n        InitializeClearWorld()\n    end\n\n    local targetX, targetY = nil, nil\n\n    while true do\n        if Config.ClearDirection == "top" and clearWY >= world.height then break end\n        if Config.ClearDirection == "bottom" and clearWY < 0 then break end\n\n        local cell = GetTile(clearWX, clearWY)\n        if cell then\n            if (cell.fg ~= 0 or cell.bg ~= 0) and not Config.ClearIgnoreBlocks[cell.fg] then\n                targetX = clearWX\n                targetY = clearWY\n                break\n            end\n        end\n\n        clearWX = clearWX + 1\n        if clearWX >= world.width then\n            clearWX = 0\n            clearWY = Config.ClearDirection == "top" and (clearWY + 1) or (clearWY - 1)\n        end\n    end\n\n    if targetX and targetY then\n        while (GetTile(targetX, targetY).fg ~= 0 or GetTile(targetX, targetY).bg ~= 0) and not Config.ClearIgnoreBlocks[GetTile(targetX, targetY).fg] do\n            if not Run or Paused or not Config.AutoClearWorld then return end -- Abort if paused by stranger or manually disabled\n            SendPacketRaw(false, {\n                type  = 3,\n                value = 18,\n                px    = targetX,\n                py    = targetY,\n                x     = targetX * 32,\n                y     = targetY * 32\n            })\n            Sleep(Config.ClearDelay)\n        end\n        clearWX = targetX + 1\n        if clearWX >= world.width then\n            clearWX = 0\n            clearWY = Config.ClearDirection == "top" and (targetY + 1) or (targetY - 1)\n        end\n    else\n        Log("`2[Auto Clear World] `0Finished clearing!")\n        Config.AutoClearWorld = false\n        clearWX, clearWY = nil, nil\n    end\nend\n\nlocal function ClearWaterStep()\n    local world = GetWorld()\n    if not world then return end\n\n    if clearWX == nil or clearWY == nil then\n        InitializeClearWorld()\n    end\n\n    local targetX, targetY = nil, nil\n\n    while true do\n        if Config.ClearDirection == "top" and clearWY >= world.height then break end\n        if Config.ClearDirection == "bottom" and clearWY < 0 then break end\n\n        local cell = GetTile(clearWX, clearWY)\n        if cell and cell.flags and cell.flags.water then\n            targetX = clearWX\n            targetY = clearWY\n            break\n        end\n\n        clearWX = clearWX + 1\n        if clearWX >= world.width then\n            clearWX = 0\n            clearWY = Config.ClearDirection == "top" and (clearWY + 1) or (clearWY - 1)\n        end\n    end\n\n    if targetX and targetY then\n        while GetTile(targetX, targetY).flags and GetTile(targetX, targetY).flags.water do\n            if not Run or Paused or not Config.AutoClearWater then return end\n            SendPacketRaw(false, {\n                type  = 3,\n                value = Config.ClearSpongeID,\n                px    = targetX,\n                py    = targetY,\n                x     = targetX * 32,\n                y     = targetY * 32\n            })\n            Sleep(Config.ClearDelay)\n        end\n        clearWX = targetX + 1\n        if clearWX >= world.width then\n            clearWX = 0\n            clearWY = Config.ClearDirection == "top" and (targetY + 1) or (targetY - 1)\n        end\n    else\n        Log("`2[Auto Clear Water] `0Finished clearing water!")\n        Config.AutoClearWater = false\n        clearWX, clearWY = nil, nil\n    end\nend\n\n-- ============================================================\n-- MAIN PUNCH LOOP\n-- ============================================================\n\nLog("Script loaded! Target tile: (" .. Config.TileX .. ", " .. Config.TileY .. ")")\nLog("Punching with ItemID: " .. Config.ItemID)\nLog("Type `4/stop`9 to stop the script.")\n\nlocal punchCount = 0\n\n-- Wait for world to load first, but allow breaking out if UI toggles Run\nwhile true do\n    if Run and not Paused then\n        if not GetLocal() or not GetWorld() then\n            Sleep(500)\n        else\n            -- Check start position once world is loaded\n            if not startX then\n                startX = math.floor(GetLocal().pos.x / 32)\n                startY = math.floor(GetLocal().pos.y / 32)\n                Log("World detected: `e" .. GetWorld().name)
