-- GHOST PLAYER PATCH (Fixes GetPlayerList caching bug)
-- ============================================================
-- forceLeft: netid -> true, means this player has been confirmed gone
-- We reset it each time WE enter a new world (OnSendPacket join_request)
local forceLeft = {}
local lastPlayersRef = {} -- for name resolving on leave

-- Bug fix: Use correct PascalCase hook names per Bothax API docs
-- 'OnSendPacket'  fires when WE send a packet (client -> server)
-- 'OnProcessTankUpdate' fires when server sends us a tank update packet

-- Reset forceLeft when we ourselves join a new world
AddHook("OnSendPacket", "GhostPlayerCleanupSend", function(type, packet)
    if type == 3 and packet:find("action|join_request") then
        forceLeft = {}
        lastPlayersRef = {}
        Log("`9[GhostPatch] World change detected - clearing player cache.`0")
    end
    return false
end)

-- Detect when server sends OnRemove to evict a player's avatar
AddHook("OnVariant", "GhostPlayerCleanupVariant", function(var)
    -- OnRemove is sent by the server when a player's entity is removed
    -- var[1] is the netid as an integer in Bothax
    if var[0] == "OnRemove" then
        local netid = tonumber(var[1])
        if netid then
            forceLeft[netid] = true
            Log("`9[GhostPatch] Forced evict netid " .. tostring(netid) .. "`0")
        end
    end
    
    -- Also catch console message "PlayerName left, X others here"
    if var[0] == "OnConsoleMessage" and type(var[1]) == "string" and var[1]:find("left,") then
        local nameStr = var[1]:match("`w([^`]+) left,")
        if nameStr then
            for netid, info in pairs(lastPlayersRef) do
                if info.name == nameStr then
                    forceLeft[netid] = true
                    Log("`9[GhostPatch] Forced evict by name: " .. nameStr .. "`0")
                end
            end
        end
    end
    return false
end)

-- ============================================================
-- MOD / DEVELOPER DETECTION (invisible entry)
-- ============================================================
-- Developers and Moderators can enter invisible (not in GetPlayerList).
-- They trigger an OnSpawn variant where their properties are sent.

AddHook("OnVariant", "ModDevDetector", function(var)
    if var[0] == "OnSpawn" then
        local spawnData = tostring(var[1] or "")
        -- Check for Developer/Moderator type flags or invisible states
        local typeVal = tonumber(spawnData:match("type|(%d+)"))
        local isMod = typeVal and ((typeVal & 4) ~= 0)
        local isDev = typeVal and ((typeVal & 8) ~= 0)
        
        -- Also check for invis/mstate flags that might indicate staff
        local isInvis = spawnData:find("invis|1") or spawnData:find("mstate|1")
        
        local name = spawnData:match("name|([^\n]+)") or "Unknown"
        local userid = tonumber(spawnData:match("userID|(%d+)"))
        
        -- We ignore our own spawn packet (Growtopia sends local|1 for the local player)
        if spawnData:find("\nlocal|1\n") or spawnData:find("local|1") then
            return false
        end
        
        -- Fallback local player check using userid
        local local_ = GetLocal()
        if local_ and local_.userid and userid == local_.userid then
            return false
        end
        
        -- Also ignore if they are in our whitelist (so you can whitelist your mod friends)
        if userid and IsWhitelisted(userid) then
            return false
        end

        if isMod or isDev or isInvis then
            local role = isDev and "`4[DEVELOPER]" or (isMod and "`6[MODERATOR]" or "`b[INVISIBLE STAFF]")
            PauseAllFeatures("ALL FEATURES PAUSED! " .. role .. "`0 detected entering world: `e" .. name)
            modDetected = true
            Run = false
        end
    end
    
    if var[0] == "OnDialogRequest" and type(var[1]) == "string" then
        local dlg = var[1]
        if dlg:find("MAGPLANT") or dlg:find("itemsucker_block") or dlg:find("itemremovedfromsucker") then
            if dlg:find("itemsucker_block") then
                local tx     = dlg:match("embed_data|tilex|(%d+)")
                local ty     = dlg:match("embed_data|tiley|(%d+)")
                local itemID = dlg:match("add_label_with_icon|small|[^|]*|left|(%d+)|")
                local amount = dlg:match("The machine contains (%d+)")

                if tx and ty then
                    local ix, iy = tonumber(tx), tonumber(ty)
                    for _, m in ipairs(MagplantsList or {}) do
                        if m.x == ix and m.y == iy then
                            if itemID then m.itemID = tonumber(itemID) end
                            if amount then
                                m.amount = tonumber(amount)
                            else
                                m.amount = 0  -- dialog opened but no items
                            end
                            break
                        end
                    end
                end
                -- Signal to ScanMagplantInfo that dialog was received
                magplantDialogReceived = true
            end
            -- Block the dialog from showing on screen if AutoMagplant is active OR ScanMagplantInfo is running
            if Config.AutoMagplant or magplantScanInfoRunning then
                return true
            end
        end
    end
    
    -- Handle Backpack Resupply UI parsing
    if var[0] == "OnDialogRequest" and type(var[1]) == "string" and var[1]:find("backpack_menu") then
        if waitingForBackpackItem then
            local dialog = var[1]
            local itemIDStr = tostring(waitingForBackpackItem)
            -- Match: add_button_with_icon|<SLOT>|<Name>|frame|<ITEM_ID>|<AMOUNT>|
            local pattern = "add_button_with_icon|(%d+)|[^|]*|frame|" .. itemIDStr .. "|"
            local slot = dialog:match(pattern)
            
            if slot then
                SendPacket(2, "action|dialog_return\ndialog_name|backpack_menu\nbuttonClicked|" .. slot)
                Log("`2Resupplied item `b" .. itemIDStr .. "`2 from backpack slot `b" .. slot .. "`0")
            else
                Log("`4Item `b" .. itemIDStr .. "`4 not found in backpack! Pausing AutoPlace.`0")
                Config.AutoPlace = false
            end
            
            waitingForBackpackItem = nil
            return true -- Block the dialog from showing on screen
        elseif (Config.AutoBackpack or Config.AutoMagplant) and Run and not Paused then
            -- Block the dialog from popping up randomly when the bot is auto-stashing items
            return true
        end
    end
    
    return false
end)

-- Get a table of current players (excluding local player), keyed by netid
local function GetOtherPlayers()
    local players = {}
    local local_ = GetLocal()
    if not local_ then return players end

    local list = GetPlayerList()
    if not list then return players end

    for _, p in pairs(list) do
        if p then
            local isLocal = false
            if p.netid == local_.netid then isLocal = true end
            if p.userid and local_.userid and tonumber(p.userid) == tonumber(local_.userid) then isLocal = true end
            if p.name and local_.name and p.name == local_.name then isLocal = true end
            if not isLocal and not forceLeft[p.netid] then
                players[p.netid] = { name = p.name, userid = p.userid }
                lastPlayersRef[p.netid] = { name = p.name, userid = p.userid }
            end

        end
    end
    return players
end

-- Punch the target tile once
local punchSavedLocX = nil
local punchSavedLocY = nil

local function PunchTile()
    if Config.AutoPunchAntiMove then
        local local_ = GetLocal()
        if local_ then
            if punchSavedLocX == nil then
                punchSavedLocX = local_.pos.x
                punchSavedLocY = local_.pos.y
            else
                local dx = math.abs(local_.pos.x - punchSavedLocX)
                local dy = math.abs(local_.pos.y - punchSavedLocY)
                if dx > 1 or dy > 1 then
                    -- Send state packet to correct position
                    SendPacketRaw(false, {
                        type = 0,
                        x = punchSavedLocX,
                        y = punchSavedLocY,
                        px = 0,
                        py = 0
                    })
                    -- Also update local position if possible? Actually just sending the packet is enough to prevent moving visually to others and server.
                end
            end
        end
    else
        punchSavedLocX = nil
        punchSavedLocY = nil
    end

    -- If auto punch was turned off, clear location elsewhere. Wait, if we are in PunchTile, AutoPunch is true.

    SendPacketRaw(false, {
        type  = 3,
