            if type(v) == "boolean" and v == true then Config[k] = true; countResumed = countResumed + 1; Log("`9 -> Resumed: `2" .. tostring(k) .. "`0") end
        end
        if countResumed == 0 then Log("`e[RESUME] `0No features were active prior to pause.") end
    end
end

