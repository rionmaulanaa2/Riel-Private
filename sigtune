local function AutoCreateFarmStep()
    local world = GetWorld()
    if not world then return end

    if farmWX == nil or farmWY == nil then
        InitializeCreateFarm()
    end

    local targetX, targetY = nil, nil

    while true do
        if Config.CreateFarmDirection == "top" and farmWY >= world.height then break end
        if Config.CreateFarmDirection == "bottom" and farmWY < 0 then break end

        -- Skip logic based on direction (alternating rows)
        local isRowValid = false
        if Config.CreateFarmDirection == "top" then
            isRowValid = (farmWY % 2 == 1)
        else
            isRowValid = ((world.height - 1 - farmWY) % 2 == 1)
        end

        if isRowValid then
            -- Skip if placing on local player pos
            local local_ = GetLocal()
            local pX = local_ and math.floor(local_.pos.x / 32)
            local pY = local_ and math.floor(local_.pos.y / 32)
            local isPlayerPos = (pX == farmWX and pY == farmWY)

            if not isPlayerPos then
                local tile = GetTile(farmWX, farmWY)
                if tile and tile.fg == 0 then
                    targetX = farmWX
                    targetY = farmWY
                    break
                end
            end
        end

        farmWX = farmWX + 1
        if farmWX >= world.width then
            farmWX = 0
            farmWY = Config.CreateFarmDirection == "top" and (farmWY + 1) or (farmWY - 1)
        end
    end

    if targetX and targetY then
        -- Check inventory
        if GetItemCount(Config.CreateFarmTarget) == 0 then
            if Config.PlaceResupplyMode == 1 then
                Log("`eOut of items! Attempting to resupply from backpack...`0")
                if TryResupplyFromBackpack(Config.CreateFarmTarget) then
                    return -- Wait for backpack UI to process
                else
                    Log("`4Failed to resupply! Out of items in backpack too. Stopping.`0")
                    Config.AutoCreateFarm = false
                    return
                end
            else
                Log("`4Out of items! Stopping Auto Create Farm.`0")
                Config.AutoCreateFarm = false
                return
            end
        end

        while GetTile(targetX, targetY).fg == 0 do
            if not Run or Paused or not Config.AutoCreateFarm then return end
            SendPacketRaw(false, {
                type  = 3,
                value = Config.CreateFarmTarget,
                px    = targetX,
                py    = targetY,
                x     = targetX * 32,
                y     = targetY * 32
            })
            Sleep(Config.CreateFarmDelay)
        end

        farmWX = targetX + 1
        if farmWX >= world.width then
            farmWX = 0
            farmWY = Config.CreateFarmDirection == "top" and (targetY + 1) or (targetY - 1)
        end
    else
        Log("`2[Auto Create Farm] `0Finished placing!")
        Config.AutoCreateFarm = false
    end
end

local function AutoPlaceStep()
