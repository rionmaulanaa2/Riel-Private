-- AUTO PUNCH WORLD LOGIC
-- ============================================================
local punchWX, punchWY = nil, nil
local punchGrid = nil
local punchGridWorld = nil
local punchGridW, punchGridH = 0, 0

local function BuildPunchGrid()
    local tiles = GetTiles()
    local world = GetWorld()
    if not tiles or not world then return false end
    punchGrid = {}
    for _, t in pairs(tiles) do
        if not punchGrid[t.x] then punchGrid[t.x] = {} end
        punchGrid[t.x][t.y] = t.fg
    end
    punchGridWorld = world.name
    punchGridW = world.width
    punchGridH = world.height
    return true
end

local function AutoPunchWorldStep()
    local world = GetWorld()
    if not world then return end

    if punchWX == nil or punchWY == nil then
        punchWX = 0
        punchWY = 0
        punchGrid = nil
        punchGridWorld = nil
    end

    -- Build/refresh cached grid only when entering a new world or first run
    if punchGrid == nil or punchGridWorld ~= world.name then
        if not BuildPunchGrid() then return end
    end

    local targetX, targetY = nil, nil

    while true do
        if punchWY >= punchGridH then break end

        local fg = punchGrid[punchWX] and punchGrid[punchWX][punchWY]

        if fg == Config.PunchWorldTarget then
            targetX = punchWX
            targetY = punchWY
            break
        end

        punchWX = punchWX + 1
        if punchWX >= punchGridW then
            punchWX = 0
            punchWY = punchWY + 1
        end
    end

    if targetX and targetY then
        -- Match exactly the method from clearworldandwaterputlgrid.lua but without retries
        while GetTile(targetX, targetY).fg == Config.PunchWorldTarget do
            if not Run or Paused or not Config.AutoPunchWorld then return end
            SendPacketRaw(false, {
                type  = 3,
                value = 18,
                px    = targetX,
                py    = targetY,
                x     = targetX * 32,
                y     = targetY * 32
            })
            Sleep(Config.PunchWorldDelay)
        end

        -- Mark as punched in cache so we advance next call
        punchGrid[targetX][targetY] = 0
        -- Advance position past current target
        punchWX = targetX + 1
        if punchWX >= punchGridW then
            punchWX = 0
            punchWY = targetY + 1
        end
    else
        -- Do one full scan of cache to detect any skipped blocks
        local skipped = false
        for x = 0, punchGridW - 1 do
            if punchGrid[x] then
                for y = 0, punchGridH - 1 do
                    if punchGrid[x][y] == Config.PunchWorldTarget then
                        skipped = true
                        break
                    end
                end
            end
            if skipped then break end
        end

        if skipped then
            Log("`6Found skipped blocks! Restarting world scan...`0")
            punchWX, punchWY = 0, 0
        else
            Log("`2Auto Punch World finished! Disabled.`0")
            Config.AutoPunchWorld = false
            punchWX = nil
            punchGrid = nil
        end
    end
end

