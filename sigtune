["Sungate"]                 = {"SG"},\n    ["Startopia"]               = {"ST"},\n    ["Auto Farm"]               = {"AF"},\n    ["Angel Wings"]             = {"AW"},\n    ["Devil Wings"]             = {"DW"},\n    ["Golden Wings"]            = {"GW"},\n    ["Dragon Wings"]            = {"DWING"},\n    ["Harvester of Sorrow"]     = {"HOS"},\n    ["Celestial Wings"]         = {"CW"},\n    ["Fairy Wings"]             = {"FW"},\n    ["Bat Wings"]               = {"BW"},\n    ["Phoenix Wings"]           = {"PW"},\n    ["Dark Wings"]              = {"DKW"},\n    ["Crystal Wings"]           = {"CRW"},\n    ["Steampunk Wings"]         = {"SPW"},\n    ["Neon Wings"]              = {"NW"},\n    ["Mummy"]                   = {"MUM"},\n    ["Fireworks"]               = {"FW"},\n    ["Geiger Charger"]          = {"GC"},\n    ["Geiger"]                  = {"GEI"},\n    ["Spotlight"]               = {"SL"},\n    ["Surg Kit"]                = {"SURGKIT"},\n    ["Laser Grid"]              = {"LG", "LASERGRID"},\n    ["Laser"]                   = {"LASER"},\n    ["Ice Cream Machine"]       = {"ICM"},\n    ["Vending Machine"]         = {"VM"},\n    ["Transmitter"]             = {"TX"},\n    ["Farmable"]                = {"FARM"},\n    ["Golden Booster"]          = {"GB"},\n    ["Fossil"]                  = {"FOSS"},\n    ["Brain"]                   = {"BRAIN"},\n    ["Dirt"]                    = {"DIRT"},\n    ["Lava"]                    = {"LAVA"},\n    ["Rock"]                    = {"ROCK"},\n    ["Bedrock"]                 = {"BED"},\n    ["Chemical G"]              = {"CG"},\n    ["Chemical H"]              = {"CH"},\n    ["Chemical K"]              = {"CK"},\n    ["Chemical R"]              = {"CR"},\n    ["Chemical S"]              = {"CS"},\n    ["Chemical X"]              = {"CX"},\n}\n\n-- State\nlocal Run          = true\nlocal Paused       = false\nlocal lastPlayers  = {}  -- Track previous player list (netid -> name)\nlocal startX, startY    -- Remember standing position\n\nlocal modDetected  = false   -- True if a mod/dev was detected invisibly\nlocal whitelistInput = ""   -- UI text input buffer for adding whitelist UIDs\nlocal manualGrowID = ""     -- UI text input buffer for manual account creation\nlocal waitingForBackpackItem = nil -- State for backpack resupply\n\n-- ============================================================\n-- UTILITIES\n-- ============================================================\n\nlocal function Log(msg)\n    LogToConsole("`0[`2SafePunch`0] `9" .. tostring(msg))\nend\n\n-- ============================================================\n-- DISCORD WEBHOOK\n-- ============================================================\n-- MakeRequest yields internally. It CANNOT be called from a hook\n-- (C-callback boundary). Solution: push jobs to a queue and drain\n-- from a dedicated RunThread where coroutine yields are legal.\n\nlocal webhookQueue = {} -- { {url, data}, ... }\n\n-- Helper to safely get time without crashing if OS lib is missing in sandbox\nlocal function GetTimeStr()\n    local t = ""\n    pcall(function()\n        if os and os.date then\n            t = " " .. os.date("[%H:%M:%S]")\n        end\n    end)\n    return t\nend\n\nlocal function SendToWebhook(content, ignoreConfig)\n    -- Step 1: check enabled\n    if not ignoreConfig and not (Config.DebugSendPacket or Config.DebugSendPacketRaw or Config.DebugVariant) then\n        return\n    end\n    -- Step 2: check URL\n    if Config.DebugWebhookURL == "" then\n        Log("`4[WH] No webhook URL set.")\n        return\n    end\n    -- Step 3: check MakeRequest exists\n    if not MakeRequest then\n        Log("`4[WH] MakeRequest is nil — not available in this Bothax build.")\n        return\n    end\n    -- Removed cooldown block here so we don't drop fast logs!\n\n    -- Safe JSON string escaper: escapes backslash, quotes, and preserves newlines as \n for Discord\n    local function esc(s)\n        s = tostring(s)\n        s = s:gsub("\\", "\\\\")    -- backslash first\n        s = s:gsub('"',  '\\"')     -- double quotes\n        s = s:gsub("\r", "")        -- strip carriage return\n        s = s:gsub("\n", "\n")     -- encode newlines as literal \n for JSON\n        s = s:gsub("\t", " ")       -- replace tabs\n        s = s:gsub("[%z\1-\9\11\12\14-\31]", "") -- strip remaining control chars except \n\n        return s\n    end\n\n    -- Format the message inside a Discord codeblock\n    local msg = "```text\n" .. content .. "\n```"\n    if #msg > 1990 then msg = msg:sub(1, 1990) .. "\n```" end\n\n    local jsonData = '{"content":"' .. esc(msg) .. '"}'\n\n    Log("`e[WH] Queuing webhook job...`0")\n    table.insert(webhookQueue, { url = Config.DebugWebhookURL, body = jsonData })\nend\n\n-- Drain thread — MakeRequest is safe here (own coroutine, can yield freely)\nRunThread(function()\n    Log("`2[WH] Webhook drain thread started.")\n    while true do\n        if #webhookQueue > 0 then\n            local job = table.remove(webhookQueue, 1)\n            Log("`e[WH] Sending...")\n            local headers = {\n                ["Content-Type"] = "application/json",\n                ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"\n            }\n            local res = MakeRequest(job.url, "POST", headers, job.body)\n            if res then\n                -- Bothax may use .status, .statusCode or .code\n                local code = res.status or res.statusCode or res.code or 0\n                if code >= 200 and code < 300 then\n                    Log("`2[WH] OK (HTTP " .. tostring(code) .. ")")\n                elseif code == 0 then\n                    -- status 0 = Bothax HTTP client got no parseable response.\n                    -- Retry without explicit headers (some builds need this).\n                    Log("`e[WH] status 0 — retrying without headers...")\n                    local res2 = MakeRequest(job.url, "POST", job.body)\n                    local code2 = (res2 and (res2.status or res2.statusCode or res2.code)) or 0\n                    if code2 >= 200 and code2 < 300 then\n                        Log("`2[WH] OK on retry (HTTP " .. tostring(code2) .. ")")\n                    else\n                        Log("`4[WH] Retry failed (HTTP " .. tostring(code2) .. ") — verify webhook URL or internet")\n                    end\n                else\n                    Log("`4[WH] HTTP " .. tostring(code) .. " — check URL / content")\n                end\n            else\n                Log("`4[WH] MakeRequest returned nil — no network response")\n            end\n            \n            -- Sleep after sending to respect Discord's rate limits\n            Sleep(Config.DebugRateLimit)\n        else\n            Sleep(50)\n        end\n    end\nend)\n\n-- ============================================================\n-- PACKET DEBUG HOOKS\n-- ============================================================\n\nAddHook("onsendpacket", "DebugPacketLogger", function(type, data)\n    if not Config.DebugSendPacket then return false end\n\n    if type == 2 or type == 3 then\n        local out = "SendPacket" .. GetTimeStr() .. "\n"\n        out = out .. "type " .. type .. ": " .. tostring(data)\n        \n        Log("`bSendPacket`0 (type " .. type .. ") logged to WH")\n        SendToWebhook(out)\n    end\n    return false\nend)\n\n-- onsendpacketraw passes a single table argument containing the packet properties\nAddHook("onsendpacketraw", "DebugPacketRawLogger", function(packet)\n    if not Config.DebugSendPacketRaw then return false end\n\n    if type(packet) == "table" then\n        local out = "SendPacketRaw" .. GetTimeStr() .. "\n"\n        out = out .. "type: " .. tostring(packet.type or 0) .. "\n"\n        out = out .. "dropped: " .. tostring(packet.dropped or 0) .. "\n"\n        out = out .. "padding1: " .. tostring(packet.padding1 or 0) .. "\n"\n        out = out .. "padding2: " .. tostring(packet.padding2 or 0) .. "\n"\n        out = out .. "netid: " .. tostring(packet.netid or 0) .. "\n"\n        out = out .. "snetid: " .. tostring(packet.snetid or 0) .. "\n"\n        out = out .. "state: " .. tostring(packet.state or 0) .. "\n"\n        out = out .. "padding4: " .. string.format("%.3f", tonumber(packet.padding4) or 0.0) .. "\n"\n        out = out .. "value: " .. tostring(packet.value or 0) .. "\n"\n        out = out .. "x, y: " .. string.format("%.3f", tonumber(packet.x) or 0.0) .. " " .. string.format("%.3f", tonumber(packet.y) or 0.0) .. "\n"\n        out = out .. "xspeed, yspeed: " .. string.format("%.3f", tonumber(packet.xspeed) or 0.0) .. " " .. string.format("%.3f", tonumber(packet.yspeed) or 0.0) .. "\n"\n        out = out .. "padding5: " .. tostring(packet.padding5 or 0) .. "\n"\n        out = out .. "tilex, tiley: " .. tostring(packet.px or 0) .. " " .. tostring(packet.py or 0) .. "\n"\n        out = out .. "extDataSize: " .. tostring(packet.extDataSize or 0)\n\n        Log("`eSendPacketRaw`0 logged to WH")\n        SendToWebhook(out)\n    else\n        Log("`eSendPacketRaw`0: unknown format (" .. type(packet) .. ")")\n    end\n    return false\nend)\n\nAddHook("onvariant", "DebugVariantLogger", function(var)\n    if not Config.DebugVariant then return false end\n\n    if type(var) == "table" then\n        local out = "VariantList" .. GetTimeStr() .. "\n"\n        for k, v in pairs(var) do\n            out = out .. "params " .. tostring(k) .. ": " .. tostring(v) .. "\n"\n        end\n        Log("`dVariantList`0 logged to WH")\n        SendToWebhook(out)\n    end\n    -- We deliberately return false here so we don't accidentally block packets\n    -- (ModDevDetector has its own hook and returns false as well)\n    return false\nend)\n\n-- Returns true if a userid is in the whitelist or is the local player\nlocal function ConfigCheckbox(label, key)\n    local c, v = ImGui.Checkbox(label, Config[key])\n    if c then\n        Config[key] = v\n        if Paused then PreviousConfig[key] = v end\n    end\n    return c, v\nend\n\nlocal function IsWhitelisted(userid)\n    local local_ = GetLocal()\n    if local_ and local_.userid and tonumber(local_.userid) == tonumber(userid) then return true end\n    for _, uid in ipairs(Config.Whitelist) do\n        if tonumber(uid) == tonumber(userid) then return true end\n    end\n    return false\nend\n\n\n-- ============================================================\n-- GHOST PLAYER PATCH (Fixes GetPlayerList caching bug)\n-- ============================================================\n-- forceLeft: netid -> true, means this player has been confirmed gone\n-- We reset it each time WE enter a new world (OnSendPacket join_request)\nlocal forceLeft = {}\nlocal lastPlayersRef = {} -- for name resolving on leave\n\n-- Bug fix: Use correct PascalCase hook names per Bothax API docs\n-- 'OnSendPacket'  fires when WE send a packet (client -> server)\n-- 'OnProcessTankUpdate' fires when server sends us a tank update packet\n\n-- Reset forceLeft when we ourselves join a new world\nAddHook("OnSendPacket", "GhostPlayerCleanupSend", function(type, packet)\n    if type == 3 and packet:find("action|join_request") then\n        forceLeft = {}\n        lastPlayersRef = {}\n        Log("`9[GhostPatch] World change detected - clearing player cache.`0")\n    end\n    return false\nend)\n\n-- Detect when server sends OnRemove to evict a player's avatar\nAddHook("OnVariant", "GhostPlayerCleanupVariant", function(var)\n    -- OnRemove is sent by the server when a player's entity is removed\n    -- var[1] is the netid as an integer in Bothax\n    if var[0] == "OnRemove" then\n        local netid = tonumber(var[1])\n        if netid then\n            forceLeft[netid] = true\n            Log("`9[GhostPatch] Forced evict netid " .. tostring(netid) .. "`0")\n        end\n    end\n    \n    -- Also catch console message "PlayerName left, X others here"\n    if var[0] == "OnConsoleMessage" and type(var[1]) == "string" and var[1]:find("left,") then\n        local nameStr = var[1]:match("`w([^`]+) left,")\n        if nameStr then\n            for netid, info in pairs(lastPlayersRef) do\n                if info.name == nameStr then\n                    forceLeft[netid] = true\n                    Log("`9[GhostPatch] Forced evict by name: " .. nameStr .. "`0")\n                end\n            end\n        end\n    end\n    return false\nend)\n\n-- ============================================================\n-- MOD / DEVELOPER DETECTION (invisible entry)\n-- ============================================================\n-- Developers and Moderators can enter invisible (not in GetPlayerList).\n-- They trigger an OnSpawn variant where their properties are sent.\n\nAddHook("onvariant", "ModDevDetector", function(var)\n    if var[0] == "OnSpawn" then\n        local spawnData = tostring(var[1] or "")\n        -- Check for Developer/Moderator type flags or invisible states\n        local typeVal = tonumber(spawnData:match("type|(%d+)"))\n        local isMod = typeVal and ((typeVal & 4) ~= 0)\n        local isDev = typeVal and ((typeVal & 8) ~= 0)\n        \n        -- Also check for invis/mstate flags that might indicate staff\n        local isInvis = spawnData:find("invis|1") or spawnData:find("mstate|1")\n        \n        local name = spawnData:match("name|([^\n]+)") or "Unknown"\n        local userid = tonumber(spawnData:match("userID|(%d+)"))\n        \n        -- We ignore our own spawn packet (Growtopia sends local|1 for the local player)\n        if spawnData:find("\nlocal|1\n") or spawnData:find("local|1") then\n            return false\n        end\n        \n        -- Fallback local player check using userid\n        local local_ = GetLocal()\n        if local_ and local_.userid and userid == local_.userid then\n            return false\n        end\n        \n        -- Also ignore if they are in our whitelist (so you can whitelist your mod friends)\n        if userid and IsWhitelisted(userid) then\n            return false\n        end\n\n        if isMod or isDev or isInvis then\n            local role = isDev and "`4[DEVELOPER]" or (isMod and "`6[MODERATOR]" or "`b[INVISIBLE STAFF]")\n            Log("`4ALL FEATURES PAUSED! " .. role .. "`0 detected entering world: `e" .. name)\n            modDetected = true\n            Paused = true\n            Run = false\n        end\n    end\n    \n    if var[0] == "OnDialogRequest" and Config.AutoMagplant and type(var[1]) == "string" then\n        if var[1]:find("MAGPLANT") or var[1]:find("itemsucker_block") or var[1]:find("itemremovedfromsucker") then\n            if var[1]:find("itemsucker_block") then\n                local tx = var[1]:match("embed_data|tilex|(%d+)")\n                local ty = var[1]:match("embed_data|tiley|(%d+)")\n                local itemID = var[1]:match("add_label_with_icon|small|[^|]*|left|(%d+)|")\n                local amount = var[1]:match("The machine contains (%d+)")\n                \n                if tx and ty then\n                    local ix, iy = tonumber(tx), tonumber(ty)\n                    for _, m in ipairs(MagplantsList or {}) do\n                        if m.x == ix and m.y == iy then\n                            if itemID then m.itemID = tonumber(itemID) end\n                            if amount then m.amount = tonumber(amount) end\n                            break\n                        end\n                    end\n                end\n            end\n            return true\n        end\n    end\n    \n    -- Handle Backpack Resupply UI parsing\n    if var[0] == "OnDialogRequest" and type(var[1]) == "string" and var[1]:find("backpack_menu") then\n        if waitingForBackpackItem then\n            local dialog = var[1]\n            local itemIDStr = tostring(waitingForBackpackItem)\n            -- Match: add_button_with_icon|<SLOT>|<Name>|frame|<ITEM_ID>|<AMOUNT>|\n            local pattern = "add_button_with_icon|(%d+)|[^|]*|frame|" .. itemIDStr .. "|"\n            local slot = dialog:match(pattern)\n            \n            if slot then\n                SendPacket(2, "action|dialog_return\ndialog_name|backpack_menu\nbuttonClicked|" .. slot)\n                Log("`2Resupplied item `b" .. itemIDStr .. "`2 from backpack slot `b" .. slot .. "`0")\n            else\n                Log("`4Item `b" .. itemIDStr .. "`4 not found in backpack! Pausing AutoPlace.`0")\n                Config.AutoPlace = false\n            end\n            \n            waitingForBackpackItem = nil\n            return true -- Block the dialog from showing on screen\n        elseif (Config.AutoBackpack or Config.AutoMagplant) and Run and not Paused then\n            -- Block the dialog from popping up randomly when the bot is auto-stashing items\n            return true\n        end\n    end\n    \n    return false\nend)\n\n-- Get a table of current players (excluding local player), keyed by netid\nlocal function GetOtherPlayers()\n    local players = {}\n    local local_ = GetLocal()\n    if not local_ then return players end\n\n    local list = GetPlayerList()\n    if not list then return players end\n\n    for _, p in pairs(list) do\n        if p then\n            local isLocal = false\n            if p.netid == local_.netid then isLocal = true end\n            if p.userid and local_.userid and tonumber(p.userid) == tonumber(local_.userid) then isLocal = true end\n            if p.name and local_.name and p.name == local_.name then isLocal = true end\n            if not isLocal and not forceLeft[p.netid] then\n                players[p.netid] = { name = p.name, userid = p.userid }\n                lastPlayersRef[p.netid] = { name = p.name, userid = p.userid }\n            end\n\n        end\n    end\n    return players\nend\n\n-- Punch the target tile once\nlocal punchSavedLocX = nil\nlocal punchSavedLocY = nil\n\nlocal function PunchTile()\n    if Config.AutoPunchAntiMove then\n        local local_ = GetLocal()\n        if local_ then\n            if punchSavedLocX == nil then\n                punchSavedLocX = local_.pos.x\n                punchSavedLocY = local_.pos.y\n            else\n                local dx = math.abs(local_.pos.x - punchSavedLocX)\n                local dy = math.abs(local_.pos.y - punchSavedLocY)\n                if dx > 1 or dy > 1 then\n                    -- Send state packet to correct position\n                    SendPacketRaw(false, {\n                        type = 0,\n                        x = punchSavedLocX,\n                        y = punchSavedLocY,\n                        px = 0,\n                        py = 0\n                    })\n                    -- Also update local position if possible? Actually just sending the packet is enough to prevent moving visually to others and server.\n                end\n            end\n        end\n    else\n        punchSavedLocX = nil\n        punchSavedLocY = nil\n    end\n\n    -- If auto punch was turned off, clear location elsewhere. Wait, if we are in PunchTile, AutoPunch is true.\n\n    SendPacketRaw(false, {\n        type  = 3,\n        value = Config.ItemID,\n        px    = Config.TileX,\n        py    = Config.TileY,\n        x     = Config.TileX * 32,\n        y     = Config.TileY * 32,\n    })\nend\n\n-- Helper function to check inventory count of an item\nlocal function GetItemCount(id)\n    local inv = GetInventory()\n    if not inv then return 0 end\n    for _, itm in pairs(inv) do\n        if itm.id == id then\n            return itm.amount\n        end\n    end\n    return 0\nend\n\n-- Check inventory and stash to backpack if needed\nlocal function CheckBackpack()\n    if not Config.AutoBackpack then return end\n    \n    for _, id in ipairs(Config.BackpackList) do\n        if GetItemCount(id) >= Config.AutoBackpackLimit then\n            Log("Inventory full! Stashing ID `b" .. tostring(id) .. "`0 to backpack...")\n            SendPacket(2, "action|dialog_return\ndialog_name|backpack_menu\nitemid|" .. tostring(id))\n            Sleep(500) -- Delay to prevent packet spam\n        end\n    end\nend\n\n-- Helper function to check if item is in take list\nlocal function IsInTakeList(id)\n    for _, listId in ipairs(Config.TakeList) do\n        if listId == id then return true end\n    end\n    return false\nend\n\n-- Helper function to calculate distance\nlocal function GetDistance(x1, y1, x2, y2)\n    return math.sqrt((x2 - x1)^2 + (y2 - y1)^2)\nend\n\n-- Collect floating items and return to start position\nlocal function CollectItems()\n    local objs = GetObjectList()\n    if not objs then return end\n\n    local validObjs = {}\n    local localPos = GetLocal().pos\n\n    for _, obj in pairs(objs) do\n        local shouldTake = not Config.UseTakeList\n        if Config.UseTakeList and IsInTakeList(obj.id) then\n            shouldTake = true\n        end\n        if shouldTake then\n            table.insert(validObjs, obj)\n        end\n    end\n\n    -- Sort by distance to player (closest first)\n    table.sort(validObjs, function(a, b)\n        return GetDistance(localPos.x, localPos.y, a.pos.x, a.pos.y) < GetDistance(localPos.x, localPos.y, b.pos.x, b.pos.y)\n    end)\n\n    local moved = false\n    for _, obj in ipairs(validObjs) do\n        -- Abort immediately if a stranger enters while we are collecting\n        if Paused then break end\n\n        local objX = math.floor(obj.pos.x / 32)\n        local objY = math.floor(obj.pos.y / 32)\n        \n        -- Only move if it's not on our exact current tile\n        local currPos = GetLocal().pos\n        local currX = math.floor(currPos.x / 32)\n        local currY = math.floor(currPos.y / 32)\n        \n        if currX ~= objX or currY ~= objY then\n            if Config.TeleportToItems then\n                -- 0ms delay pathing (extremely fast walking, acts like teleport to server)\n                FindPath(objX, objY, 0)\n                Sleep(50)\n            else\n                FindPath(objX, objY, 100)\n                Sleep(200)\n            end\n            moved = true\n        end\n\n        -- After picking up each item, check if backpack needs stashing\n        if Config.AutoBackpack then\n            CheckBackpack()\n        end\n    end\n\n    if moved and startX and startY then\n        -- Return to original position\n        if Config.TeleportToItems then\n            FindPath(startX, startY, 0)\n            Sleep(50)\n        else\n            FindPath(startX, startY, 100)\n            Sleep(300)\n        end\n    end\nend\n\n-- ============================================================\n-- AUTO PLACE LOGIC\n-- ============================================================\nlocal placeX, placeY = nil, nil\nlocal placeGrid = nil        -- cached tile grid\nlocal placeGridWorld = nil   -- world name when grid was built\nlocal placeGridW, placeGridH = 0, 0\n\n\nlocal function InitializePlace()\n    local world = GetWorld()\n    if not world then return end\n    if Config.PlaceDirection == "top" then\n        placeY = 0\n    else\n        placeY = world.height - 1\n    end\n    placeX = 0\n    -- Force grid rebuild on start\n    placeGrid = nil\n    placeGridWorld = nil\nend\n\n\nlocal farmWX, farmWY = nil, nil\n\nlocal function InitializeCreateFarm()\n    local world = GetWorld()\n    if not world then return end\n    if Config.CreateFarmDirection == "top" then\n        farmWY = 0\n    else\n        farmWY = world.height - 1\n    end\n    farmWX = 0\nend\n\nlocal function AutoCreateFarmStep()\n    local world = GetWorld()\n    if not world then return end\n\n    if farmWX == nil or farmWY == nil then\n        InitializeCreateFarm()\n    end\n\n    local targetX, targetY = nil, nil\n\n    while true do\n        if Config.CreateFarmDirection == "top" and farmWY >= world.height then break end\n        if Config.CreateFarmDirection == "bottom" and farmWY < 0 then break end\n\n        -- Skip logic based on direction (alternating rows)\n        local isRowValid = false\n        if Config.CreateFarmDirection == "top" then\n            isRowValid = (farmWY % 2 == 1)\n        else\n            isRowValid = ((world.height - 1 - farmWY) % 2 == 1)\n        end\n\n        if isRowValid then\n            -- Skip if placing on local player pos\n            local local_ = GetLocal()\n            local pX = local_ and math.floor(local_.pos.x / 32)\n            local pY = local_ and math.floor(local_.pos.y / 32)\n            local isPlayerPos = (pX == farmWX and pY == farmWY)\n\n            if not isPlayerPos then\n                local tile = GetTile(farmWX, farmWY)\n                if tile and tile.fg == 0 then\n                    targetX = farmWX\n                    targetY = farmWY\n                    break\n                end\n            end\n        end\n\n        farmWX = farmWX + 1\n        if farmWX >= world.width then\n            farmWX = 0\n            farmWY = Config.CreateFarmDirection == "top" and (farmWY + 1) or (farmWY - 1)\n        end\n    end\n\n    if targetX and targetY then\n        -- Check inventory\n        if GetItemCount(Config.CreateFarmTarget) == 0 then\n            if Config.PlaceResupplyMode == 1 then\n                Log("`eOut of items! Attempting to resupply from backpack...`0")\n                if TryResupplyFromBackpack(Config.CreateFarmTarget) then\n                    return -- Wait for backpack UI to process\n                else\n                    Log("`4Failed to resupply! Out of items in backpack too. Stopping.`0")\n                    Config.AutoCreateFarm = false\n                    return\n                end\n            else\n                Log("`4Out of items! Stopping Auto Create Farm.`0")\n                Config.AutoCreateFarm = false\n                return\n            end\n        end\n\n        while GetTile(targetX, targetY).fg == 0 do\n            if not Run or Paused or not Config.AutoCreateFarm then return end\n            SendPacketRaw(false, {\n                type  = 3,\n                value = Config.CreateFarmTarget,\n                px    = targetX,\n                py    = targetY,\n                x     = targetX * 32,\n                y     = targetY * 32\n            })\n            Sleep(Config.CreateFarmDelay)\n        end\n\n        farmWX = targetX + 1\n        if farmWX >= world.width then\n            farmWX = 0\n            farmWY = Config.CreateFarmDirection == "top" and (targetY + 1) or (targetY - 1)\n        end\n    else\n        Log("`2[Auto Create Farm] `0Finished placing!")\n        Config.AutoCreateFarm = false\n    end\nend\n\nlocal function AutoPlaceStep()\n    local world = GetWorld()\n    if not world then return end\n\n    if placeX == nil or placeY == nil then\n        InitializePlace()\n    end\n\n    local targetX, targetY = nil, nil\n\n    while true do\n        if Config.PlaceDirection == "top" and placeY >= world.height then break end\n        if Config.PlaceDirection == "bottom" and placeY < 0 then break end\n\n        -- Skip if placing on local player pos\n        local local_ = GetLocal()\n        local pX = local_ and math.floor(local_.pos.x / 32)\n        local pY = local_ and math.floor(local_.pos.y / 32)\n        local isPlayerPos = (pX == placeX and pY == placeY)\n\n        if not isPlayerPos then\n            local tile = GetTile(placeX, placeY)\n            if tile and tile.fg == 0 then\n                targetX = placeX\n                targetY = placeY\n                break\n            end\n        end\n\n        placeX = placeX + 1\n        if placeX >= world.width then\n            placeX = 0\n            placeY = Config.PlaceDirection == "top" and (placeY + 1) or (placeY - 1)\n        end\n    end\n\n    if targetX and targetY then\n        -- Check inventory\n        if GetItemCount(Config.PlaceItemID) == 0 then\n            if Config.PlaceResupplyMode == 1 then\n                Log("`eOut of items! Attempting to resupply from backpack...`0")\n                if TryResupplyFromBackpack() then\n                    return -- Sleep until next loop\n                else\n                    Log("`4Failed to resupply! Out of items in backpack too. Stopping.`0")\n                    Config.AutoPlace = false\n                    return\n                end\n            else\n                Log("`4[Auto Place] `0Out of items! Stopping.")\n                Config.AutoPlace = false\n                return\n            end\n        end\n\n        while GetTile(targetX, targetY).fg == 0 do\n            if not Run or Paused or not Config.AutoPlace then return end\n            SendPacketRaw(false, {\n                type  = 3,\n                value = Config.PlaceItemID,\n                px    = targetX,\n                py    = targetY,\n                x     = targetX * 32,\n                y     = targetY * 32\n            })\n            Sleep(Config.PlaceDelay)\n        end\n        placeX = targetX + 1\n        if placeX >= world.width then\n            placeX = 0\n            placeY = Config.PlaceDirection == "top" and (targetY + 1) or (targetY - 1)\n        end\n    else\n        Log("`2[Auto Place] `0Finished placing!")\n        Config.AutoPlace = false\n        placeX, placeY = nil, nil\n    end\nend\n\n-- ============================================================\n-- AUTO PUNCH WORLD LOGIC\n-- ============================================================\nlocal punchWX, punchWY = nil, nil\nlocal lastHarvestY = nil\nlocal punchGrid = nil\n\nlocal punchGridWorld = nil\nlocal punchGridW, punchGridH = 0, 0\n\n\nlocal function InitializePunchWorld()\n    local world = GetWorld()\n    if not world then return end\n    if Config.PunchDirection == "top" then\n        punchWY = 0\n    else\n        punchWY = world.height - 1\n    end\n    lastHarvestY = nil\n    punchWX = 0\n\n    punchGrid = nil\n    punchGridWorld = nil\nend\n\n\nMagplantsList = {}\nlocal currentMagplantIndex = 1\n\nfunction ScanMagplants()\n    MagplantsList = {}\n    currentMagplantIndex = 1\n    local world = GetWorld()\n    if not world then return end\n    \n    for x = 0, world.width - 1 do\n        for y = 0, world.height - 1 do\n            local fg = GetTile(x, y).fg\n            if fg == 5638 or fg == 5930 then\n                table.insert(MagplantsList, {x = x, y = y, itemID = nil, amount = nil})\n            end\n        end\n    end\n    Log("`2[Auto Magplant] Scanned and found `b" .. #MagplantsList .. "`2 magplants in world.`0")\n    if #MagplantsList == 0 then\n        Config.AutoMagplant = false\n    end\nend\n\nlocal function AutoMagplantStep()\n    if not Config.AutoMagplant then return end\n    if currentMagplantIndex > #MagplantsList then\n        Log("`2[Auto Magplant] All magplants processed! Stopping.`0")\n        Config.AutoMagplant = false\n        return\n    end\n    \n    local m = MagplantsList[currentMagplantIndex]\n    \n    -- Wrench magplant to open dialog (this updates itemID and amount asynchronously via OnVariant)\n    SendPacketRaw(false, {type = 3, value = 32, px = m.x, py = m.y, x = m.x * 32, y = m.y * 32})\n    Sleep(Config.MagplantDelay)\n    \n    if not Run or Paused or not Config.AutoMagplant then return end\n    \n    -- If amount is 0 (or was updated to 0), skip to next\n    if m.amount and m.amount == 0 then\n        Log("`4[Auto Magplant] Magplant at " .. m.x .. "," .. m.y .. " is empty! Moving to next.`0")\n        currentMagplantIndex = currentMagplantIndex + 1\n        return\n    end\n    \n    -- Attempt retrieve\n    SendPacket(2, "action|dialog_return\ndialog_name|itemsucker_block\ntilex|" .. m.x .. "|\ntiley|" .. m.y .. "|\nbuttonClicked|retrieveitem\n\nchk_enablesucking|1\n")\n    Sleep(Config.MagplantDelay)\n    \n    if not Run or Paused or not Config.AutoMagplant then return end\n    \n    SendPacket(2, "action|dialog_return\ndialog_name|itemremovedfromsucker\ntilex|" .. m.x .. "|\ntiley|" .. m.y .. "|\nitemtoremove|250\n")\n    Sleep(Config.MagplantDelay)\n    \n    -- Stash to backpack if we know the item ID\n    if m.itemID then\n        SendPacket(2, "action|dialog_return\ndialog_name|backpack_menu\nitemid|" .. tostring(m.itemID))\n        Sleep(Config.MagplantDelay)\n    end\nend\n\nlocal function AutoPunchWorldStep()\n    local world = GetWorld()\n    if not world then return end\n\n    if punchWX == nil or punchWY == nil then\n        InitializePunchWorld()\n    end\n\n    local targetX, targetY = nil, nil\n\n    while true do\n        if Config.PunchDirection == "top" and punchWY >= world.height then break end\n        if Config.PunchDirection == "bottom" and punchWY < 0 then break end\n\n        local realTile = GetTile(punchWX, punchWY)\n        if realTile and realTile.fg == Config.PunchWorldTarget then\n            targetX = punchWX\n            targetY = punchWY\n            break\n        end\n\n        punchWX = punchWX + 1\n        if punchWX >= world.width then\n            punchWX = 0\n            punchWY = Config.PunchDirection == "top" and (punchWY + 1) or (punchWY - 1)\n        end\n    end\n\n    if targetX and targetY then\n        if Config.PunchWorldHarvestMode and lastHarvestY ~= targetY then\n            lastHarvestY = targetY\n            SendPacketRaw(false, {\n                type = 0,\n                x = 0,\n                y = targetY * 32,\n                px = 0,\n                py = 0\n            })\n            Log("`2[Harvest Mode] Teleported to start of row Y: " .. targetY .. "`0")\n            Sleep(200)\n        end\n        -- Match exactly the method from clearworldandwaterputlgrid.lua but without retries\n        while GetTile(targetX, targetY).fg == Config.PunchWorldTarget do\n            if not Run or Paused or not Config.AutoPunchWorld then return end\n            SendPacketRaw(false, {\n                type  = 3,\n                value = 18,\n                px    = targetX,\n                py    = targetY,\n                x     = targetX * 32,\n                y     = targetY * 32\n            })\n            Sleep(Config.PunchWorldDelay)\n        end\n        -- UPDATE NEXT TARGET TO PREVENT RESCANNING SAME BLOCK\n        punchWX = targetX + 1\n        if punchWX >= world.width then\n            punchWX = 0\n            punchWY = Config.PunchDirection == "top" and (targetY + 1) or (targetY - 1)\n        end\n    else\n        Log("`2[Auto Punch World] `0Finished punching!")\n        Config.AutoPunchWorld = false\n        punchWX, punchWY = nil, nil\n    end\nend\n\n-- ============================================================\n-- IMGUI UI\n-- ============================================================\nlocal function CreateRandomAccount()\n    local letters = "abcdefghijklmnopqrstuvwxyz"\n    local name = ""\n    for i = 1, 3 do\n        local r = math.random(1, #letters)\n        name = name .. letters:sub(r, r)\n    end\n    name = name .. tostring(math.random(10, 99))\n    \n    local password = name\n    local email = name .. "@gmail.com"\n    \n    local packet = "action|dialog_return\ndialog_name|growid_apply\nman|1\nwoman|0\n"\n    packet = packet .. "logon|" .. name .. "\n"\n    packet = packet .. "password|" .. password .. "\n"\n    packet = packet .. "password_verify|" .. password .. "\n"\n    packet = packet .. "email|" .. email .. "\n"\n    packet = packet .. "affcode|"\n    \n    SendPacket(2, packet)\n    Log("`2Auto Created Account! Name: `0" .. name)\n    \n    local whLog = "```yaml\n"\n    whLog = whLog .. "New Account Created:\n"\n    whLog = whLog .. "GrowID: " .. name .. "\n"\n    whLog = whLog .. "Password: " .. password .. "\n"\n    whLog = whLog .. "Email: " .. email .. "\n"\n    whLog = whLog .. "```"\n    \n    SendToWebhook(whLog, true)\nend\n\nlocal guiOpen = true\n\nlocal function ShowUI()\n    if not ImGui then return end\n    if not guiOpen then return end\n\n    local world  = GetWorld()\n    local local_ = GetLocal()\n\n    -- Match sb imgui.lua pattern exa