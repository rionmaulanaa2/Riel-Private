-- Auto Harvest
local harvestY, harvestRowMinY, harvestRowMaxY, harvestXIndex = nil, nil, nil, 1
local harvestTargetRows = {}, lastHarvestTeleportY = nil, currentHarvestX = nil

local function InitializeHarvest()
    local world = GetWorld()
    if not world or type(world) ~= "table" or type(world.width) ~= "number" or type(world.height) ~= "number" or world.width <= 0 or world.height <= 0 then return false end
    harvestTargetRows = {}
    for y = 0, world.height - 1 do harvestTargetRows[y] = {}; for x = 0, world.width - 1 do local isValidX = true; if Config.HarvestStep == 3 then if not (x == 0 or x == 1 or ((x - 1) % 3 == 0)) then isValidX = false end end; if isValidX then table.insert(harvestTargetRows[y], x) end end end
    harvestRowMinY = 0; harvestRowMaxY = world.height - 1
    harvestY = Config.HarvestDirection == "top" and 0 or harvestRowMaxY
    harvestXIndex = 1; lastHarvestTeleportY = nil
    Log("`9[Auto Harvest] `0Initialized! Dir: " .. Config.HarvestDirection .. ", Step: " .. Config.HarvestStep)
    return true
end

local function AutoHarvestStep()
    local world = GetWorld()
    if not world or type(world) ~= "table" or type(world.width) ~= "number" or type(world.height) ~= "number" then Sleep(200); return end
    if harvestY == nil or harvestRowMinY == nil or harvestRowMaxY == nil then if not InitializeHarvest() then return end end
    if Config.HarvestDirection == "top" then if harvestY > harvestRowMaxY then Log("`2[Auto Harvest] `0Finished!"); Config.AutoHarvest = false; harvestY = nil; currentHarvestX = nil; return end
    else if harvestY < harvestRowMinY then Log("`2[Auto Harvest] `0Finished!"); Config.AutoHarvest = false; harvestY = nil; currentHarvestX = nil; return end end
    local xList = harvestTargetRows[harvestY]
    if not xList or harvestXIndex > #xList then harvestXIndex = 1; harvestY = Config.HarvestDirection == "top" and (harvestY + 1) or (harvestY - 1); return end
    local targetX, targetTile = nil, nil; local maxSkips, skipped = 100, 0
    while harvestXIndex <= #xList and skipped < maxSkips do
        local tx = xList[harvestXIndex]; local tile = SafeGetTile(tx, harvestY)
        if tile.fg == Config.HarvestItemID or tile.bg == Config.HarvestItemID then targetX = tx; targetTile = tile; break end
        harvestXIndex = harvestXIndex + 1; skipped = skipped + 1
    end
    if not targetX or not targetTile then
        if harvestXIndex > #xList then harvestXIndex = 1; harvestY = Config.HarvestDirection == "top" and (harvestY + 1) or (harvestY - 1) end
        return
    end
    if lastHarvestTeleportY ~= harvestY then lastHarvestTeleportY = harvestY; local range = math.max(1, harvestRowMaxY - harvestRowMinY); local progress = math.floor((math.abs(harvestY - harvestRowMinY) / range) * 100); Log("`2[Auto Harvest] `0Row Y: `b" .. harvestY .. "`0/" .. harvestRowMaxY .. " (" .. progress .. "%)") end
    currentHarvestX = targetX
    SendPacketRaw(false, {type = 0, x = targetX * 32, y = harvestY * 32, px = targetX, py = harvestY})
    SendPacketRaw(false, {type = 3, value = 18, px = targetX, py = harvestY, x = targetX * 32, y = harvestY * 32})
    harvestXIndex = harvestXIndex + 1
end

