-- Event-driven player tracking
AddHook("OnVariant", "PlayerTrackerVariant", function(var)
    -- OnSpawn: player joined
    if var[0] == "OnSpawn" then
        local spawnData = tostring(var[1] or "")
        if spawnData:find("local|1") then return false end -- Skip self
        local netid = tonumber(spawnData:match("netID|(%d+)"))
        local userid = tonumber(spawnData:match("userID|(%d+)"))
        local name = StripColors(spawnData:match("name|([^\n]+)") or "")
        if netid and not forceLeft[netid] then
            local local_ = GetLocal()
            if local_ and (local_.netid == netid or (local_.userid and tonumber(local_.userid) == userid)) then return false end
            livePlayers[netid] = {name = name, userid = userid}
            lastPlayersRef[netid] = {name = name, userid = userid}
            playerJoinTime[netid] = os and os.clock and os.clock() or 0
            Log("`9[PlayerTrack] `0Joined: `e" .. name .. "`0 (netid " .. netid .. ")")
        end
    end
    -- OnRemove: player left
    if var[0] == "OnRemove" then
        local netid = tonumber(var[1])
        if netid then
            local info = livePlayers[netid] or lastPlayersRef[netid]
            local name = info and info.name or "(netid " .. tostring(netid) .. ")"
            livePlayers[netid] = nil; forceLeft[netid] = true
            Log("`9[PlayerTrack] `0Left: `e" .. name .. "`0 (netid " .. netid .. ")")
        end
    end
    -- Console fallback
    if var[0] == "OnConsoleMessage" and type(var[1]) == "string" then
        local msg = var[1]
        if msg:find("left,") or msg:find("left the world") then
            local cleanMsg = StripColors(msg)
            local nameStr = cleanMsg:match("(.+) left,") or cleanMsg:match("(.+) left the world")
            if nameStr then
                nameStr = nameStr:match("^%s*(.-)%s*$")
                for netid, info in pairs(lastPlayersRef) do
                    local cleanName = StripColors(info.name)
                    if cleanName == nameStr or cleanName:lower() == nameStr:lower() then
                        livePlayers[netid] = nil; forceLeft[netid] = true
                        Log("`9[PlayerTrack] `0Console evict: `e" .. nameStr .. "`0")
                    end
                end
            end
        end
    end
    return false
end)

-- THE FIX: SINGLE GetOtherPlayers() that properly uses forceLeft
function GetOtherPlayers()
    local local_ = GetLocal()
    if not local_ then return {} end
    local list = GetPlayerList()
    if list then
        for _, p in pairs(list) do
            if p and p.netid and not forceLeft[p.netid] then
                local isLocal = false
                if p.netid == local_.netid then isLocal = true end
                if p.userid and local_.userid and tonumber(p.userid) == tonumber(local_.userid) then isLocal = true end
                if not isLocal and not livePlayers[p.netid] then
                    livePlayers[p.netid] = {name = p.name, userid = p.userid}
                    lastPlayersRef[p.netid] = {name = p.name, userid = p.userid}
                end
            end
        end
    end
    local result = {}
    for netid, info in pairs(livePlayers) do
        if not forceLeft[netid] then result[netid] = info else livePlayers[netid] = nil end
    end
    return result
end

