local placeX, placeY = nil, nil
local placeGrid = nil        -- cached tile grid
local placeGridWorld = nil   -- world name when grid was built
local placeGridW, placeGridH = 0, 0

local function BuildPlaceGrid()
    local tiles = GetTiles()
    local world = GetWorld()
    if not tiles or not world then return false end
    placeGrid = {}
    for _, t in pairs(tiles) do
        if not placeGrid[t.x] then placeGrid[t.x] = {} end
        placeGrid[t.x][t.y] = t.fg
    end
    placeGridWorld = world.name
    placeGridW = world.width
    placeGridH = world.height
    return true
end

local function InitializePlace()
    local world = GetWorld()
    if not world then return end
    if Config.PlaceDirection == "top" then
        placeY = 0
    else
        placeY = world.height - 1
    end
    placeX = 0
    -- Force grid rebuild on start
    placeGrid = nil
    placeGridWorld = nil
end

local function AutoPlaceStep()
    local world = GetWorld()
    if not world then return end

    if placeX == nil or placeY == nil then
        InitializePlace()
    end

    -- Build/refresh cached grid only when entering a new world or first run
    if placeGrid == nil or placeGridWorld ~= world.name then
        if not BuildPlaceGrid() then return end
    end

    local targetX, targetY = nil, nil

    while true do
        if Config.PlaceDirection == "top" and placeY >= placeGridH then break end
        if Config.PlaceDirection == "bottom" and placeY < 0 then break end

        local fg = placeGrid[placeX] and placeGrid[placeX][placeY]

        -- fg == 0 means blank foreground tile
        if fg == 0 then
            targetX = placeX
            targetY = placeY
            -- Mark as placed in cache so next call skips it immediately
            placeGrid[placeX][placeY] = Config.PlaceItemID
            -- Advance coordinate for next call
            placeX = placeX + 1
            if placeX >= placeGridW then
                placeX = 0
                placeY = Config.PlaceDirection == "top" and (placeY + 1) or (placeY - 1)
            end
            break
        end

        -- Advance if not blank
        placeX = placeX + 1
        if placeX >= placeGridW then
            placeX = 0
            placeY = Config.PlaceDirection == "top" and (placeY + 1) or (placeY - 1)
        end
    end

    if targetX and targetY then
        -- Check inventory
        if GetItemCount(Config.PlaceItemID) == 0 then
            if Config.PlaceResupplyMode == 1 then
                Log("`eOut of items! Attempting to resupply from backpack...`0")
                SendPacket(2, "action|input\n|text|/bp")
                waitingForBackpackItem = Config.PlaceItemID
                Sleep(1500) -- Sleep to let the dialog arrive and be processed
                return
            else
                Log("`4Out of items to place! Pausing AutoPlace.`0")
                Config.AutoPlace = false
                return
            end
        end

        -- Place remotely in a relentless loop until the block physically appears
        while GetTile(targetX, targetY).fg == 0 do
            if not Run or Paused or not Config.AutoPlace then return end
            if GetItemCount(Config.PlaceItemID) == 0 then break end -- Exit loop if we run out of items mid-placement
            
            SendPacketRaw(false, {
                type  = 3,
                value = Config.PlaceItemID,
                px    = targetX,
                py    = targetY,
                x     = targetX * 32,
                y     = targetY * 32
            })
            Sleep(Config.PlaceDelay)
        end
        
        -- Update cache so we advance properly
        placeGrid[targetX][targetY] = Config.PlaceItemID
        
        placeX = targetX + 1
        if placeX >= placeGridW then
            placeX = 0
            placeY = Config.PlaceDirection == "top" and (targetY + 1) or (targetY - 1)
        end
    else
        Log("`2Auto Place finished filling the world! Disabled.`0")
        Config.AutoPlace = false
        placeX = nil
        placeGrid = nil
    end
end

