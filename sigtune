-- ============================================================
-- RECORD & PLAY LOGIC
-- ============================================================
isRecording = false
isPlaying = false
recordData = {}
lastPacketTime = 0

function SaveRecording(filename)
    if not filename or filename == "" then filename = "default_record" end
    local file = io.open(filename .. ".txt", "w")
    if file then
        for _, pkt in ipairs(recordData) do
            file:write(pkt.delay .. "|" .. pkt.data .. "\n")
        end
        file:close()
        Log("`2Saved recording to: " .. filename .. ".txt")
    else
        Log("`4Failed to save recording! Check folder permissions.")
    end
end

function LoadRecording(filename)
    if not filename or filename == "" then filename = "default_record" end
    local file = io.open(filename .. ".txt", "r")
    if file then
        recordData = {}
        for line in file:lines() do
            local delayStr, dataStr = line:match("^(%d+)|(.+)$")
            if delayStr and dataStr then
                table.insert(recordData, {delay = tonumber(delayStr), data = dataStr})
            end
        end
        file:close()
        Log("`2Loaded recording: " .. filename .. ".txt with " .. #recordData .. " packets.")
        return true
    else
        Log("`4File not found: " .. filename .. ".txt")
        return false
    end
end

function StartPlayback()
    if #recordData == 0 then
        Log("`4No data to play! Load a recording first.")
        return
    end
    isPlaying = true
    RunThread(function()
        Log("`2Playback started...")
        for _, pkt in ipairs(recordData) do
            if not isPlaying or not Run or Paused then break end
            if pkt.delay > 0 then
                Sleep(pkt.delay)
            end
            
            -- Parse data
            if pkt.data:sub(1,3) == "RAW" then
                local t, v, px, py, rx, ry = pkt.data:match("^RAW|(%d+)|(%d+)|(%-?%d+)|(%-?%d+)|(%-?%d+)|(%-?%d+)$")
                if t then
                    SendPacketRaw(false, {
                        type = tonumber(t),
                        value = tonumber(v),
                        px = tonumber(px),
                        py = tonumber(py),
                        x = tonumber(rx),
                        y = tonumber(ry)
                    })
                end
            elseif pkt.data:sub(1,3) == "STR" then
                local typStr, content = pkt.data:match("^STR|(%d+)|(.+)$")
                if typStr and content then
                    -- Unescape newlines
                    content = content:gsub("\n", "\n")
                    SendPacket(tonumber(typStr), content)
                end
            end
        end
        if isPlaying then
            Log("`2Playback finished.")
        else
            Log("`4Playback stopped.")
        end
        isPlaying = false
    end)
end

AddHook("OnSendPacket", "RecordPacketsHook", function(type, packet)
    if isRecording then
        -- Ignore normal chat logs, but KEEP user commands (like /bp, /ui, etc)
        if packet:find("action|input\n|text|") and not packet:find("action|input\n|text|/") then return false end
        
        local now = os.clock()
        local delay = 0
        if lastPacketTime > 0 then
            delay = math.floor((now - lastPacketTime) * 1000)
        end
