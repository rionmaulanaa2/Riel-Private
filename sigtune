    local targetID = Config.HarvestItemID
    harvestTargetRows = {}
    local minY, maxY = nil, nil

    -- Pre-calculate valid X set for 3-far or 1-far
    local validX = {}
    if Config.HarvestStep == 3 then
        validX[0] = true
        local curr = 1
        while curr < world.width do
            validX[curr] = true
            curr = curr + 3
        end
    else
        for x = 0, world.width - 1 do
            validX[x] = true
        end
    end

    -- Fast 1-pass tile indexing
    for _, t in pairs(tiles) do
        if (t.fg == targetID or t.bg == targetID) and validX[t.x] then
            if not harvestTargetRows[t.y] then
                harvestTargetRows[t.y] = {}
            end
            table.insert(harvestTargetRows[t.y], t.x)

            if minY == nil or t.y < minY then minY = t.y end
            if maxY == nil or t.y > maxY then maxY = t.y end
        end
    end

    if not minY or not maxY then
        Log("`4[Auto Harvest] Target Item ID (" .. tostring(Config.HarvestItemID) .. ") not found in world!")
        Config.AutoHarvest = false
        harvestY = nil
        return false
    end

    -- Sort X coordinates ascending per row
    for y, xList in pairs(harvestTargetRows) do
        table.sort(xList)
    end

    harvestRowMinY = minY
    harvestRowMaxY = maxY

    if Config.HarvestDirection == "top" then
        harvestY = minY
    else
        harvestY = maxY
    end

    harvestXIndex = 1
    lastHarvestTeleportY = nil

    Log("`9[Auto Harvest] `0Initialized! Target ID: " .. Config.HarvestItemID .. ", Range Y: " .. minY .. " -> " .. maxY .. ", Dir: " .. Config.HarvestDirection .. ", Step: " .. Config.HarvestStep .. " far")
    return true
end

local function AutoHarvestStep()
    local world = GetWorld()
    if not world then return end

    if harvestY == nil then
        if not InitializeHarvest() then return end
    end

    -- Fast empty-row jump: skip rows with no remaining targets in 0ms
    while true do
        if Config.HarvestDirection == "top" then
            if harvestY > harvestRowMaxY then
                Log("`2[Auto Harvest] `0Finished harvesting all target items!")
                Config.AutoHarvest = false
                harvestY = nil
                return
            end
        else
            if harvestY < harvestRowMinY then
                Log("`2[Auto Harvest] `0Finished harvesting all target items!")
                Config.AutoHarvest = false
                harvestY = nil
                return
            end
        end

        local xList = harvestTargetRows[harvestY]
        if xList and #xList > 0 and harvestXIndex <= #xList then
            break -- Row has target items to process!
        end

        -- Move to next row immediately (0ms overhead for empty rows)
        harvestXIndex = 1
        if Config.HarvestDirection == "top" then
            harvestY = harvestY + 1
        else
            harvestY = harvestY - 1
        end
    end

    -- Teleport player to x=0 of current row if row changed
    if lastHarvestTeleportY ~= harvestY then
        lastHarvestTeleportY = harvestY
        SendPacketRaw(false, {
            type = 0,
            x    = 0,
            y    = harvestY * 32,
            px   = 0,
            py   = 0
        })
        Log("`2[Auto Harvest] Teleported to X=0 row Y: " .. harvestY)
        Sleep(150)
    end

    local xList = harvestTargetRows[harvestY]
    local targetX = xList and xList[harvestXIndex]

    if targetX then
        -- Send 1 punch packet to target tile
        SendPacketRaw(false, {
            type  = 3,
            value = 18,
            px    = targetX,
            py    = harvestY,
            x     = targetX * 32,
            y     = harvestY * 32
        })

        -- Advance to next target position in current row
        harvestXIndex = harvestXIndex + 1
    else
        -- Move to next Y row
        harvestXIndex = 1
        if Config.HarvestDirection == "top" then
            harvestY = harvestY + 1
        else
            harvestY = harvestY - 1
        end
    end
end


