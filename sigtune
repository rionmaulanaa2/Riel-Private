-- Parse all available tool button IDs from the dialog string
-- Returns a set: { [toolID] = true, ... }
local function ParseAvailableTools(dlg)
    local available = {}
    for toolID in dlg:gmatch("add_button_with_icon|tool(%d+)|") do
        local id = tonumber(toolID)
        if id and id ~= 0 then
            available[id] = true
        end
    end
    return available
end

-- Core surgery decision engine
-- Uses the exact same condition priority as the proven working script.
-- Checks are done on the raw dialog string (dlg) + tool availability check.
local function DecideSurgeryTool(dlg)
    local function has(id)
        return dlg:find("tool" .. tostring(id)) ~= nil
    end

    -- 1. Patient wakes up mid-surgery
    if dlg:find("`4The patient wakes up!") and has(1262) then
        return 1262, "Anesthetic [woke up]"
    end

    -- 2. Patient screams / flails (waking)
    if dlg:find("`4The patient screams and flails!") and has(1262) then
        return 1262, "Anesthetic [screaming]"
    end

    -- 3. Heart stopped → Defibrillator
    if dlg:find("Status: `4Heart stopped!") and has(4312) then
        return 4312, "Defibrillator [heart stopped]"
    end

    -- 4. Coming to / regaining consciousness → Anesthetic
    if dlg:find("Status: `6Coming to") and has(1262) then
        return 1262, "Anesthetic [coming to]"
    end

    -- 5. Bad pulse (red) → Transfusion
    if dlg:find("Pulse: `4") and has(4310) then
        return 4310, "Transfusion [bad pulse]"
    end

    -- 6. High temp (red `4) → Antibiotic if available, else Lab Kit
    if dlg:find("Temp: `4%d+") then
        if has(1266) then return 1266, "Antibiotic [temp red]" end
        if has(4318) then return 4318, "Lab Kit [temp red]" end
    end

    -- 7. Elevated temp (light `6) → Antibiotic if available, else Lab Kit
    if dlg:find("Temp: `6%d+") then
        if has(1266) then return 1266, "Antibiotic [temp orange]" end
        if has(4318) then return 4318, "Lab Kit [temp orange]" end
    end

    -- 8. Mild temp (yellow `3) → Antibiotic if available, else Lab Kit
    if dlg:find("Temp: `3%d+") then
        if has(1266) then return 1266, "Antibiotic [temp mild]" end
        if has(4318) then return 4318, "Lab Kit [temp mild]" end
    end

    -- 9. Losing blood very quickly → Clamp first, then Stitches
    if dlg:find("Patient is losing blood `4very quickly!") then
        if has(4314) then return 4314, "Clamp [critical bleed]" end
        if has(1270) then return 1270, "Stitches [critical bleed]" end
    end

    -- 10. Losing blood (moderate) → Clamp first, then Stitches
    if dlg:find("Patient is `6losing blood!") then
        if has(4314) then return 4314, "Clamp [bleed]" end
        if has(1270) then return 1270, "Stitches [bleed]" end
    end

    -- 11. Incisions = 0 (green `2) → Fix It
    if dlg:find("Incisions: `20") and has(1296) then
        return 1296, "Fix It [inc=0 green]"
    end

    -- 12. Incisions = 0 (yellow `3) → Fix It
    if dlg:find("Incisions: `30") and has(1296) then
        return 1296, "Fix It [inc=0 yellow]"
    end

    -- 13. Not diagnosed → Ultrasound
    if dlg:find("The patient has not been diagnosed.") and has(4316) then
        return 4316, "Ultrasound [diagnose]"
    end

    -- 14. Status Awake (red `4) → Anesthetic
    if dlg:find("Status: `4Awake") and has(1262) then
        return 1262, "Anesthetic [awake red]"
    end

    -- 15. Bones broken (yellow `6 or red `4) → Splint
    if (dlg:find("Bones: `6.+ broken") or dlg:find("Bones: `4.+ broken")) and has(1268) then
        return 1268, "Splint [broken]"
    end

    -- 16. Broke arm
    if dlg:find("Patient broke his arm.") and has(1270) then
        return 1270, "Stitches [broke arm]"
    end

    -- 17. Status Awake (yellow `3) → Anesthetic
    if dlg:find("Status: `3Awake") and has(1262) then
        return 1262, "Anesthetic [awake yellow]"
    end

    -- 18. Weak pulse (light `6) → Transfusion
    if dlg:find("Pulse: `6") and has(4310) then
        return 4310, "Transfusion [weak pulse]"
    end

    -- 19. Can't see at all → Sponge
    if dlg:find("`4You can't see what you are doing!") and has(1258) then
        return 1258, "Sponge [blind]"
    end

    -- 20. Fix It + Stitches both present → Stitches (closing incisions)
    if dlg:find("tool1296") and dlg:find("tool1270") then
        return 1270, "Stitches [close]"
    end

    -- 21. Bones shattered (multi, any color combo) → Pins first, then Scalpel
    if dlg:find("Bones: `.+, `.+ shattered") then
        if has(4308) then return 4308, "Pins [shattered multi]" end
        if has(1260) then return 1260, "Scalpel [shattered multi]" end
    end

    -- 22. Bones shattered (single, any color) → Pins first, then Scalpel
    if dlg:find("Bones: `.+ shattered") then
        if has(4308) then return 4308, "Pins [shattered]" end
        if has(1260) then return 1260, "Scalpel [shattered]" end
    end

    -- 23. Broke leg
    if dlg:find("Patient broke his leg.") and has(1270) then
        return 1270, "Stitches [broke leg]"
    end

    -- 24. Losing blood slowly → Clamp
    if dlg:find("Patient is losing blood `3slowly.") and has(4314) then
        return 4314, "Clamp [slow bleed]"
    end

    -- 25. Default: Scalpel if available (make incisions)
    if has(1260) then return 1260, "Scalpel [default]" end

    -- 26. Last resort fallbacks
    if has(1258) then return 1258, "Sponge (fallback)" end
    if has(1296) then return 1296, "Fix It (fallback)" end
    if has(4316) then return 4316, "Ultrasound (fallback)" end

    return nil, nil
end


