local function GetItemNameByID(id)
    if not id or tonumber(id) == 0 then return "Empty" end
    id = tonumber(id)

    if GetItemInfo then
        local ok, info = pcall(GetItemInfo, id)
        if ok and info and info.name and info.name ~= "" then
            return info.name
        end
    end

    if GetItemByIDSafe then
        local ok, info = pcall(GetItemByIDSafe, id)
        if ok and info and info.name and info.name ~= "" then
            return info.name
        end
    end

    if GetItemInfoList then
        local ok, list = pcall(GetItemInfoList)
        if ok and list and list[id] and list[id].name then
            return list[id].name
        end
    end

    return "Item #" .. tostring(id)
end

