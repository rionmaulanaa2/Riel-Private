                    currentKillerTarget = survivor
                    local sHrp = survivor.HumanoidRootPart

                    -- Pursue survivor if outside hit reach
                    if dist > hitReachDistance then
                        travelToSurvivor(survivor)
                    end

                    -- When in reach, execute Auto Hit
                    if (myHrp.Position - sHrp.Position).Magnitude <= (hitReachDistance + 2) then
                        if autoHitSurvivorEnabled and (tick() - lastKillerHitTime > 0.75) then
                            lastKillerHitTime = tick()
                            executeKillerHit(survivor)
                            WindUI:Notify({ Title = "⚔️ Hit Executed!", Content = "Struck " .. survivor.Name, Duration = 1.5 })
                        end
                    end
                end)
                task.wait(0.1)
            end
            currentKillerTarget = nil
        end)
    end
