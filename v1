local function isPlayerKiller()
    local myChar = player.Character
    if not myChar then return false end
    if myChar:GetAttribute("Butcher") or myChar:GetAttribute("isAttacking") ~= nil or myChar:GetAttribute("isLunging") ~= nil then
        return true
    end
    if myChar.Name:lower():find("killer") or myChar.Name:lower():find("butcher") or myChar.Name:lower():find("slasher") or myChar.Name:lower():find("cure") or myChar.Name:lower():find("jason") then
        return true
    end
    local k = getKiller()
    if k and k == myChar then
        return true
    end
    return false
end

-- Validates that target is an active Survivor (EXCLUDES knocked down, hooked & carried)
local function isSurvivorValidTarget(c)
    if not c or not c.Parent then return false end
    if c == player.Character then return false end
    local hum = c:FindFirstChildOfClass("Humanoid")
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return false end

    -- Exclude Killer models
    if c:GetAttribute("Butcher") or c:GetAttribute("isAttacking") ~= nil or c:GetAttribute("isLunging") ~= nil or c.Name:lower():find("killer") or c.Name:lower():find("butcher") or c.Name:lower():find("slasher") or c.Name:lower():find("cure") or c.Name:lower():find("jason") then
        return false
    end

    -- 1. Exclude Knocked Down / Downed survivors
    local isKnocked = c:GetAttribute("Knocked") == true
        or c:GetAttribute("isKnocked") == true
        or c:GetAttribute("Downed") == true
        or c:GetAttribute("isDowned") == true
        or c:FindFirstChild("downed") ~= nil
        or c:FindFirstChild("Knocked") ~= nil
        or (CollectionService and CollectionService:HasTag(c, "Knocked"))
        or (c:GetAttribute("State") and tostring(c:GetAttribute("State")):lower():find("down"))
        or hum.Health < 30

    if isKnocked then return false end

    -- 2. Exclude Hooked survivors
    local isHooked = c:GetAttribute("IsHooked") == true
        or c:GetAttribute("isHooked") == true
        or c:GetAttribute("HookPhase") ~= nil
        or c:FindFirstChild("Hooked") ~= nil
        or (c.Parent and c.Parent.Name:lower():find("hook"))

    if isHooked then return false end

    -- 3. Exclude Carried survivors
    local isCarried = c:GetAttribute("IsCarried") == true
        or c:GetAttribute("isCarried") == true
        or c:GetAttribute("BeingCarried") == true
        or c:FindFirstChild("Carried") ~= nil

    if isCarried then return false end

    return true
end

local function findNearestSurvivor()
    local myChar = player.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end

    local bestTarget = nil
    local bestDist = math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character ~= myChar then
            local c = plr.Character
            if isSurvivorValidTarget(c) then
                local hrp = c:FindFirstChild("HumanoidRootPart")
                local dist = (myHrp.Position - hrp.Position).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    bestTarget = c
                end
            end
        end
    end

    -- Check non-player survivor character models in workspace
    if not bestTarget then
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:IsA("Model") and obj ~= myChar and obj:FindFirstChildOfClass("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                if isSurvivorValidTarget(obj) then
                    local hrp = obj.HumanoidRootPart
                    local dist = (myHrp.Position - hrp.Position).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        bestTarget = obj
                    end
                end
            end
        end
    end

    return bestTarget, bestDist
end

-- Continuous frame-locked Auto Aim for Killer
local function updateKillerAim(state)
    if killerAimConn then
        pcall(function() killerAimConn:Disconnect() end)
        killerAimConn = nil
    end

    if not state then return end

    killerAimConn = RunService.RenderStepped:Connect(function()
        if not autoAimSurvivorEnabled or not autoCatchEnabled then return end
        pcall(function()
            local myChar = player.Character
            local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myHrp or not currentKillerTarget or not currentKillerTarget.Parent then return end

            local sHrp = currentKillerTarget:FindFirstChild("HumanoidRootPart")
            if not sHrp then return end

            local cam = workspace.CurrentCamera
            local aimPos = sHrp.Position + Vector3.new(0, 1.2, 0)

            -- Lock Camera smoothly directly at Survivor
            cam.CFrame = CFrame.lookAt(cam.CFrame.Position, aimPos)

            -- Lock Killer body towards Survivor for server hit validation
            local lookTarget = Vector3.new(sHrp.Position.X, myHrp.Position.Y, sHrp.Position.Z)
            myHrp.CFrame = CFrame.lookAt(myHrp.Position, lookTarget)
        end)
    end)
end

-- Comprehensive Auto Hit execution across Android executors and PC
local function executeKillerHit(targetChar)
    local remotes = getVDRemotes()
    local myChar = player.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    local sHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if sHrp then
        local lookTarget = Vector3.new(sHrp.Position.X, myHrp.Position.Y, sHrp.Position.Z)
        myHrp.CFrame = CFrame.lookAt(myHrp.Position, lookTarget)
    end

    -- 1. Violence District Remote Events
    if remotes.Attacks then
        if remotes.Attacks:FindFirstChild("BasicAttack") then
            pcall(function() remotes.Attacks.BasicAttack:FireServer() end)
        end
        if remotes.Attacks:FindFirstChild("Lunge") then
            pcall(function() remotes.Attacks.Lunge:FireServer() end)
        end
        if remotes.Attacks:FindFirstChild("LungeDetect") and targetChar then
            pcall(function() remotes.Attacks.LungeDetect:FireServer(targetChar) end)
        end
    end

    -- 2. Character Equipped Tool Activation
    for _, item in ipairs(myChar:GetChildren()) do
        if item:IsA("Tool") then
            pcall(function() item:Activate() end)
        end
    end

    -- 3. Mobile Touch GUI Button Activation (Delta/Fluxus/Arceus/Codex on Android)
    pcall(function()
        local pg = player:FindFirstChild("PlayerGui")
        if pg then
            for _, name in ipairs({"basicattack", "Attack", "Punch", "AttackButton", "Slash", "Swing"}) do
                local btn = pg:FindFirstChild(name, true)
                if btn and btn:IsA("GuiButton") then
                    if typeof(firesignal) == "function" then
                        firesignal(btn.MouseButton1Down)
                        firesignal(btn.Activated)
                    end
                end
            end
        end
    end)

    -- 4. PC VirtualInputManager Click Fallback
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.02)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
end

local function travelToSurvivor(targetChar)
    local myChar = player.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not myHrp or not targetChar then return false end

    local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetHrp then return false end

    local targetPos = targetHrp.Position
    local dist = (myHrp.Position - targetPos).Magnitude
    if dist <= hitReachDistance then return true end

    if killerTravelMode == "Instant Teleport" then
        local behindCFrame = CFrame.new(targetPos - targetHrp.CFrame.LookVector * 2.5, targetPos)
        myHrp.CFrame = behindCFrame
        task.wait(0.05)
        return true

    elseif killerTravelMode == "Safe Teleport" then
        local step = math.clamp(safeTeleportStep or 0.5, 0.1, 2.0)
        while autoCatchEnabled and targetChar.Parent and isSurvivorValidTarget(targetChar) and (myHrp.Position - targetHrp.Position).Magnitude > hitReachDistance do
            local currentPos = myHrp.Position
            local toTarget = (targetHrp.Position - currentPos)
            local remainingDist = toTarget.Magnitude
            if remainingDist <= step then
                myHrp.CFrame = CFrame.new(targetHrp.Position - toTarget.Unit * 2, targetHrp.Position)
                break
            end

            local moveVec = toTarget.Unit * step
            local nextPos = currentPos + moveVec

            -- Wall and Collision Check when NoClip is disabled
            if not noClipEnabled then
                local hasWall, hitPart = checkWallCollision(currentPos, nextPos, myChar)
                if hasWall then
                    WindUI:Notify({ Title = "⚠️ Wall Blocked", Content = "Wall in path! Enable NoClip to phase through.", Duration = 2 })
                    return false
                end
            end

            myHrp.CFrame = CFrame.new(nextPos, nextPos + moveVec)
            task.wait(0.01)
        end
        return (myHrp.Position - targetHrp.Position).Magnitude <= hitReachDistance

    elseif killerTravelMode == "Run Normally" then
        local PathfindingService = game:GetService("PathfindingService")
        local path = PathfindingService:CreatePath({
            AgentRadius = 2.5,
            AgentHeight = 5,
            AgentCanJump = true
        })

        pcall(function()
            path:ComputeAsync(myHrp.Position, targetHrp.Position)
        end)

        local waypoints = path.Status == Enum.PathStatus.Success and path:GetWaypoints() or { { Position = targetHrp.Position } }
        pcall(function() myChar:SetAttribute("Sprinting", true) end)

        for _, wp in ipairs(waypoints) do
            if not autoCatchEnabled or not targetChar.Parent or not isSurvivorValidTarget(targetChar) then break end
            if (myHrp.Position - targetHrp.Position).Magnitude <= hitReachDistance then break end

            if not noClipEnabled then
                local hasWall, hitPart = checkWallCollision(myHrp.Position, wp.Position, myChar)
                if hasWall and hum then
                    hum.Jump = true
                end
            end

            if hum then
                hum:MoveTo(wp.Position)
                local timeout = tick() + 1.5
                while (myHrp.Position - wp.Position).Magnitude > 3.5 and tick() < timeout and autoCatchEnabled do
                    task.wait(0.05)
                end
            end
        end
        return (myHrp.Position - targetHrp.Position).Magnitude <= hitReachDistance
    end

    return false
end

