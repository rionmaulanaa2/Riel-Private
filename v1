-- Killer detection helper (Violence District CollectionService, Team & Attribute Detection)
local function getKiller()
    local myChar = player.Character
    local CollectionService = game:GetService("CollectionService")

    -- 1. Check CollectionService "Killer" tag (Official Violence District method)
    pcall(function()
        for _, obj in ipairs(CollectionService:GetTagged("Killer")) do
            if obj and obj:IsA("Model") and obj ~= myChar then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local hrp = obj:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    return obj
                end
            end
        end
    end)

    -- 2. Check Players on Killer Team, with Killer attribute, or with CollectionService Tag
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character ~= myChar then
            local char = plr.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                local isKillerTeam = plr.Team and (plr.Team.Name == "Killer" or plr.Team.Name:lower():find("killer") or (plr.Team.Name ~= "Survivors" and plr.Team.Name ~= "Lobby" and plr.Team.Name ~= "Choosing"))
                local hasKillerAttr = plr:GetAttribute("IsKiller") == true 
                    or char:GetAttribute("IsKiller") == true 
                    or char:GetAttribute("Butcher") == true 
                    or char:GetAttribute("killerend") ~= nil
                    or char:GetAttribute("isAttacking") ~= nil
                    or char:GetAttribute("isLunging") ~= nil
                local hasKillerTag = CollectionService:HasTag(char, "Killer") or CollectionService:HasTag(plr, "Killer")

                if isKillerTeam or hasKillerAttr or hasKillerTag then
                    return char
                end
            end
        end
    end

    -- 3. Check workspace models for killer attributes or names
    for _, model in ipairs(workspace:GetChildren()) do
        if model:IsA("Model") and model ~= myChar then
            local hum = model:FindFirstChildOfClass("Humanoid")
            local hrp = model:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                if CollectionService:HasTag(model, "Killer")
                    or model:GetAttribute("Butcher")
                    or model:GetAttribute("IsKiller") == true
                    or model:GetAttribute("isAttacking") ~= nil
                    or model:GetAttribute("isLunging") ~= nil
                    or model:GetAttribute("isStunned") ~= nil
                    or model.Name:lower():find("killer")
                    or model.Name:lower():find("butcher")
                    or model.Name:lower():find("slasher")
                    or model.Name:lower():find("cure")
                    or model.Name:lower():find("jason") then
                    return model
                end
            end
        end
    end

    return nil
end

local function isPlayerKiller()
    local myChar = player.Character
    if not myChar then return false end
    local CollectionService = game:GetService("CollectionService")

    if CollectionService:HasTag(myChar, "Killer") or CollectionService:HasTag(player, "Killer") then
